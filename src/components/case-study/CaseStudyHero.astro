---
import { Icon } from "astro-icon/components";
import Link from "../link/Link.astro";

interface Props {
  kicker: string;
  title: string;
  tagline: string;
  prevHref?: string;
}

const { kicker, title, tagline, prevHref = "/" } = Astro.props;
---

<header class="cs-hero">
  <Link href={prevHref} underline className="cs-hero-back"
    ><Icon name="arrow-left-long" />Back to home</Link
  >
  <p class="cs-kicker">{kicker}</p>
  <h1 class="cs-title">{title}</h1>
  <p class="cs-tagline">{tagline}</p>
  <div class="cs-meta">
    <slot name="meta" />
  </div>
</header>
