---
import { Image } from "astro:assets";
import CaseStudyFooterNav from "../../components/case-study/CaseStudyFooterNav.astro";
import CaseStudyHero from "../../components/case-study/CaseStudyHero.astro";
import MetaItem from "../../components/case-study/MetaItem.astro";
import SectionHeading from "../../components/case-study/SectionHeading.astro";
import Stat from "../../components/case-study/Stat.astro";
import StatRow from "../../components/case-study/StatRow.astro";
import Link from "../../components/link/Link.astro";
import Tag from "../../components/tag/Tag.astro";
import Layout from "../../layouts/Layout.astro";
import "./ux-projects.css";

import trustyLoading from "../../images/Trusty-Loading-screen.png";
import trustyLanding from "../../images/Trusty-Landing-page.png";
import trustyExplain from "../../images/Trusty-Explanation.png";
import trustyDS from "../../images/Trusty-design-system.png";
import trustyBranding from "../../images/Trusty-Branding.png";
import trustyFlow from "../../images/Trusty-flow.png";
import trustyNewsPage from "../../images/Trusty-News-page.png";
import trustyPersonalization from "../../images/Trusty-personalization.png";
---

<Layout title="Trusty - UX Project | Xiaolei Qin's Portfolio">
  <div class="project-container">
    <CaseStudyHero
      title="Trusty"
      tagline="A mobile app that helps users check the credibility of the news they read, with clear visual cues and a feed built from the sources they trust."
    />

    <div class="cs-hero-media cs-wide flex md:flex-row gap-4 overflow-x-auto lg:justify-center">
      <Image
        format="jpeg"
        src={trustyLoading}
        alt="Trusty loading screen"
        width={473}
        quality={100}
      />
      <Image
        format="jpeg"
        src={trustyLanding}
        alt="Trusty landing page"
        width={473}
        quality={100}
      />
      <Image
        format="jpeg"
        src={trustyExplain}
        alt="Trusty explanation screen"
        width={488}
        quality={100}
      />
    </div>

    <div class="cs-meta cs-wide">
      <MetaItem label="Project type">
        <p class="cs-inline-result">Adobe Creative Jam, mobile UI</p>
      </MetaItem>
      <MetaItem label="My role">
        <Tag>UI designer</Tag>
        <Tag>Brand designer</Tag>
      </MetaItem>
      <MetaItem label="Tools">
        <Tag>Adobe XD</Tag>
        <Tag>Figma</Tag>
        <Tag>Illustrator</Tag>
      </MetaItem>
      <MetaItem label="Result">
        <p class="cs-inline-result">Honorable mention, top 20 of 315</p>
      </MetaItem>
    </div>

    <StatRow>
      <Stat value="315" label="competitors in the 2021 Adobe Creative Jam" />
      <Stat value="Top 20" label="finish, earning an honorable mention" />
    </StatRow>

    <SectionHeading index="01" title="Research" id="research" />
    <div class="cs-section-body">
      <p class="project-description">
        People struggle to verify news on social media. We studied Apple News and
        <em>The New York Times</em> and found that a neutral, clean, transparent
        interface feels serious and unbiased. The Jam&apos;s schedule left no time
        for surveys, so we designed from those insights.
      </p>
    </div>

    <SectionHeading index="02" title="Design" id="design" />
    <div class="cs-section-body">
      <p class="cs-subhead">Branding</p>
      <p class="project-description">
        Dark gray and creamy white keep the app neutral yet inviting. A simple
        serif &ldquo;T&rdquo; logo signals a formal, trustworthy tone, echoing print
        newspapers like <em>The New York Times</em>.
      </p>
      <div
        class="flex lg:flex-col flex-shrink-0 justify-evenly overflow-x-auto"
      >
        <Image
          format="jpeg"
          src={trustyBranding}
          alt="Branding of Trusty app"
          width={430}
          quality={100}
          class="rounded-[var(--border-radius)] m-1 object-cover"
          style={{ boxShadow: "0 1px 4px rgba(0,0,0,0.15)" }}
        />
        <Image
          format="jpeg"
          src={trustyDS}
          alt="Design system of Trusty app"
          width={458}
          quality={100}
          class="rounded-[var(--border-radius)] m-1 object-cover"
          style={{ boxShadow: "0 1px 4px rgba(0,0,0,0.15)" }}
        />
      </div>
      <div class="cs-inline-detail">
        <p class="cs-subhead">Design system details</p>
        <p class="project-description">
          Near-black text on near-white, like Apple News, keeps information serious
          and credible. Blue is the action color, and green and red mark
          &ldquo;verified&rdquo; and &ldquo;not verified.&rdquo; Georgia sets
          headlines, Arial handles body text, and Montserrat is the UI font.
        </p>
      </div>
    </div>

    <SectionHeading index="03" title="User flow" id="user-flow" />
    <div class="cs-section-body">
      <p class="project-description">
        New users choose their news categories and sources first. Each headline
        then shows a green check if verified or a red &ldquo;X&rdquo; if debunked,
        with links to other outlets covering the story.
      </p>
      <div
        class="flex lg:flex-col flex-shrink-0 justify-evenly overflow-x-auto"
      >
        <Image
          format="jpeg"
          src={trustyPersonalization}
          alt="Category preference setting page"
          width={390}
          quality={100}
          class="rounded-[var(--border-radius)] m-1 object-cover"
          style={{ boxShadow: "0 1px 4px rgba(0,0,0,0.15)" }}
        />
        <Image
          format="jpeg"
          src={trustyNewsPage}
          alt="Example news page with verification indicator"
          width={390}
          quality={100}
          class="rounded-[var(--border-radius)] m-1 object-cover"
          style={{ boxShadow: "0 1px 4px rgba(0,0,0,0.15)" }}
        />
      </div>
      <div class="cs-inline-detail">
        <p class="cs-subhead">Handling misinformation</p>
        <p class="project-description">
          If an article is later proven false, everyone who engaged with it gets a
          notification with links to what actually happened.
        </p>
      </div>
      <p class="project-description">
        Try the prototype: <Link
          aria-label="Adobe XD Prototype (opens a new window)"
          href="https://xd.adobe.com/view/3e5904f8-347a-412f-9f67-bb6cd05324f1-6b0a/"
          newTab
          underline>Adobe XD Prototype</Link
        >
      </p>
    </div>

    <Image
      format="jpeg"
      src={trustyFlow}
      alt="Full user flow of the Trusty app"
      width={2320}
      quality={100}
      class="rounded-[var(--border-radius)] m-1 object-cover"
      style={{ boxShadow: "0 1px 4px rgba(0,0,0,0.15)" }}
    />

    <SectionHeading index="04" title="Feedback" id="feedback" />
    <div class="cs-section-body">
      <p class="project-description">
        The design drew a lot of attention at the showcase. Without full user
        feedback, we learned it needed more color, larger and heavier type, and
        spacing that follows accessibility standards.
      </p>
    </div>

    <CaseStudyFooterNav
      prev={{ href: "/#projects", label: "Back to all projects" }}
    />
  </div>
</Layout>
