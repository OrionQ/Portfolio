---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import CaseStudyHero from "../../components/case-study/CaseStudyHero.astro";
import MetaItem from "../../components/case-study/MetaItem.astro";
import SectionHeading from "../../components/case-study/SectionHeading.astro";
import Stat from "../../components/case-study/Stat.astro";
import StatRow from "../../components/case-study/StatRow.astro";
import Link from "../../components/link/Link.astro";
import Tag from "../../components/tag/Tag.astro";
import Layout from "../../layouts/Layout.astro";
import "./ux-projects.css";

import trustyLoading from "../../images/Trusty-Loading-screen.png";
import trustyLanding from "../../images/Trusty-Landing-page.png";
import trustyExplain from "../../images/Trusty-Explanation.png";
import trustyDS from "../../images/Trusty-design-system.png";
import trustyBranding from "../../images/Trusty-Branding.png";
import trustyFlow from "../../images/Trusty-flow.png";
import trustyNewsPage from "../../images/Trusty-News-page.png";
import trustyPersonalization from "../../images/Trusty-personalization.png";
---

<Layout title="Trusty - UX Project | Xiaolei Qin's Portfolio">
  <div class="project-container">
    <CaseStudyHero
      kicker="Adobe Creative Jam — Mobile UI"
      title="Trusty"
      tagline="Your guide to credible news. Trusty flags misinformation at a glance, so you know what to trust before you share it."
    />

    <div class="flex md:flex-row gap-4 overflow-x-auto lg:justify-center">
      <Image format="jpeg" src={trustyLoading} alt="Trusty loading screen" width={250} />
      <Image format="jpeg" src={trustyLanding} alt="Trusty landing page" width={250} />
      <Image format="jpeg" src={trustyExplain} alt="Trusty explanation screen" width={250} />
    </div>

    <div class="cs-meta">
      <MetaItem label="Role">
        <Tag>UI designer</Tag>
        <Tag>Brand designer</Tag>
      </MetaItem>
      <MetaItem label="Tools">
        <Tag>Adobe XD</Tag>
        <Tag>Figma</Tag>
        <Tag>Illustrator</Tag>
      </MetaItem>
      <MetaItem label="Result">
        <p class="cs-inline-result">Top 20 of 315 — honorable mention</p>
      </MetaItem>
    </div>

    <StatRow>
      <Stat value="315" label="teams competed in the Adobe Creative Jam" />
      <Stat value="Top 20" label="finish, earning an honorable mention" />
      <Stat value="48 hrs" label="from brief to finished prototype" />
    </StatRow>

    <SectionHeading index="01" title="Research" id="research" />
    <div class="cs-section-body">
      <p class="project-description">
        <strong>Problem:</strong> most people can&apos;t tell fact from
        misinformation on social media. We had no time to survey users — the
        Jam&apos;s clock was ticking. So we studied trusted apps instead:
        Apple News, The New York Times. What makes a platform feel serious
        and unbiased? A clean, neutral interface.
      </p>
    </div>

    <SectionHeading index="02" title="Design" id="design" />
    <div class="cs-section-body">
      <p class="cs-subhead">Branding</p>
      <p class="project-description">
        Dark gray and creamy white — neutral, not cold. A serif
        &ldquo;T&rdquo; wordmark borrows the formality of print, a nod to
        <em>The New York Times</em>.
      </p>
      <div
        class="flex lg:flex-col flex-shrink-0 justify-evenly overflow-x-auto"
      >
        <Image
          format="jpeg"
          style={{ boxShadow: "0 1px 4px rgba(0,0,0,0.15)" }}
          src={trustyBranding}
          alt="Branding of Trusty app"
          width={250}
          class="rounded-[var(--border-radius)] m-1 object-cover"
        />
        <Image
          format="jpeg"
          style={{ boxShadow: "0 1px 4px rgba(0,0,0,0.15)" }}
          src={trustyDS}
          alt="Design system of Trusty app"
          width={250}
          class="rounded-[var(--border-radius)] m-1 object-cover"
        />
      </div>
      <div class="cs-inline-detail">
        <p class="cs-subhead">Design system details</p>
        <p class="project-description">
          Near-black on near-white, like Apple News. Blue for actions;
          green and red for &ldquo;verified&rdquo; and &ldquo;not
          verified&rdquo; — colors people already read instinctively.
          Georgia for headlines, Arial for body text, Montserrat for the UI.
        </p>
      </div>
    </div>

    <SectionHeading index="03" title="User flow" id="user-flow" />
    <div class="cs-section-body">
      <p class="project-description">
        <strong>Solution:</strong> new users pick their trusted sources
        first. Then every headline gets a clear cue: a green check for
        verified, a red &ldquo;X&rdquo; for debunked, plus a link to other
        outlets covering the same story.
      </p>
      <div
        class="flex lg:flex-col flex-shrink-0 justify-evenly overflow-x-auto"
      >
        <Image
          format="jpeg"
          style={{ boxShadow: "0 1px 4px rgba(0,0,0,0.15)" }}
          src={trustyPersonalization}
          alt="Category preference setting page"
          width={250}
          class="rounded-[var(--border-radius)] m-1 object-cover"
        />
        <Image
          format="jpeg"
          style={{ boxShadow: "0 1px 4px rgba(0,0,0,0.15)" }}
          src={trustyNewsPage}
          alt="Example news page with verification indicator"
          width={250}
          class="rounded-[var(--border-radius)] m-1 object-cover"
        />
      </div>
      <div class="cs-inline-detail">
        <p class="cs-subhead">Handling misinformation</p>
        <p class="project-description">
          If an article turns out false, anyone who read it gets notified —
          with links to what actually happened.
        </p>
      </div>
      <p class="project-description">
        Try the prototype: <Link
          aria-label="Adobe XD Prototype (opens a new window)"
          href="https://xd.adobe.com/view/3e5904f8-347a-412f-9f67-bb6cd05324f1-6b0a/"
          newTab
          underline>Adobe XD Prototype</Link
        >
      </p>
    </div>

    <Image
      format="jpeg"
      style={{ boxShadow: "0 1px 4px rgba(0,0,0,0.15)" }}
      src={trustyFlow}
      alt="Full user flow of the Trusty app"
      class="rounded-[var(--border-radius)] m-1 object-cover"
    />

    <SectionHeading index="04" title="Feedback" id="feedback" />
    <div class="cs-section-body">
      <p class="project-description">
        We didn&apos;t have time to user-test, but the showcase drew real
        attention. Judges pointed us toward more color, bolder type, and
        stricter spacing for accessibility — all good notes for the next
        round.
      </p>
    </div>

    <div class="cs-footer-nav">
      <Link href="/" underline
        ><Icon name="arrow-left-long" />Go back to the home page</Link
      >
    </div>
  </div>
</Layout>
