---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import CaseStudyHero from "../../components/case-study/CaseStudyHero.astro";
import Disclosure from "../../components/disclosure/Disclosure.astro";
import MetaItem from "../../components/case-study/MetaItem.astro";
import SectionHeading from "../../components/case-study/SectionHeading.astro";
import Stat from "../../components/case-study/Stat.astro";
import StatRow from "../../components/case-study/StatRow.astro";
import Link from "../../components/link/Link.astro";
import Tag from "../../components/tag/Tag.astro";
import Layout from "../../layouts/Layout.astro";
import "./ux-projects.css";

import trustyLoading from "../../images/Trusty-Loading-screen.png";
import trustyLanding from "../../images/Trusty-Landing-page.png";
import trustyExplain from "../../images/Trusty-Explanation.png";
import trustyDS from "../../images/Trusty-design-system.png";
import trustyBranding from "../../images/Trusty-Branding.png";
import trustyFlow from "../../images/Trusty-flow.png";
import trustyNewsPage from "../../images/Trusty-News-page.png";
import trustyPersonalization from "../../images/Trusty-personalization.png";
---

<Layout title="Trusty - UX Project | Xiaolei Qin's Portfolio">
  <div class="project-container">
    <CaseStudyHero
      kicker="Adobe Creative Jam — Mobile UI"
      title="Trusty"
      tagline="Your guide to credible news. A mobile app that filters misinformation at a glance, so users can tell what to trust before they share it."
    >
      <Fragment slot="meta">
        <MetaItem label="Role">
          <Tag>UI designer</Tag>
          <Tag>Brand designer</Tag>
        </MetaItem>
        <MetaItem label="Tools">
          <Tag>Adobe XD</Tag>
          <Tag>Figma</Tag>
          <Tag>Illustrator</Tag>
        </MetaItem>
        <MetaItem label="Result">
          <p class="cs-inline-result">Top 20 of 315 — honorable mention</p>
        </MetaItem>
      </Fragment>
    </CaseStudyHero>

    <div class="cs-gallery">
      <Image format="jpeg" src={trustyLoading} alt="Trusty loading screen" width={320} />
      <Image format="jpeg" src={trustyLanding} alt="Trusty landing page" width={320} />
      <Image format="jpeg" src={trustyExplain} alt="Trusty explanation screen" width={320} />
    </div>

    <StatRow>
      <Stat value="315" label="teams competed in the Adobe Creative Jam" />
      <Stat value="Top 20" label="finish, earning an honorable mention" />
      <Stat value="48 hrs" label="from brief to finished prototype" />
    </StatRow>

    <SectionHeading index="01" title="Research" id="research" />
    <div class="cs-section-body">
      <p class="project-description">
        We audited major news apps — Apple News, The New York Times — to find
        what makes a platform read as serious and unbiased: a neutral, clean,
        transparent interface. Survey time was limited by the Jam&apos;s
        clock, so those principles became our north star instead.
      </p>
    </div>

    <SectionHeading index="02" title="Design" id="design" />
    <div class="cs-section-body">
      <p class="cs-subhead">Branding</p>
      <p class="project-description">
        Dark gray and creamy white for a tone that&apos;s neutral, not
        cold. A serif &ldquo;T&rdquo; wordmark borrows the formality of
        print newspapers — a nod to <em>The New York Times</em> and the
        trust that comes with it.
      </p>
      <div class="cs-gallery">
        <Image
          format="jpeg"
          src={trustyBranding}
          alt="Branding of Trusty app"
          width={420}
        />
        <Image
          format="jpeg"
          src={trustyDS}
          alt="Design system of Trusty app"
          width={420}
        />
      </div>
      <Disclosure title="Design system details" className="cs-detail">
        <p class="project-description">
          Near-black text on near-white, echoing Apple News&apos; clarity.
          Blue stays neutral for actions; green and red flag
          &ldquo;verified&rdquo; and &ldquo;not verified&rdquo; using
          colors people already read instinctively. Georgia carries
          headlines for formality, Arial handles body copy for
          readability, and Montserrat rounds out the system with a bold,
          modern UI voice.
        </p>
      </Disclosure>
    </div>

    <SectionHeading index="03" title="User flow" id="user-flow" />
    <div class="cs-section-body">
      <p class="project-description">
        First-time users onboard by picking preferred sources and
        categories, then land on a home page that plainly explains how
        verification works. Every headline carries a clear cue: a green
        check for verified, a red &ldquo;X&rdquo; for debunked, and a
        link out to other outlets covering the same story.
      </p>
      <div class="cs-gallery">
        <Image
          format="jpeg"
          src={trustyPersonalization}
          alt="Category preference setting page"
          width={320}
        />
        <Image
          format="jpeg"
          src={trustyNewsPage}
          alt="Example news page with verification indicator"
          width={320}
        />
      </div>
      <Disclosure title="Handling misinformation" className="cs-detail">
        <p class="project-description">
          When an article is proven false, anyone who engaged with it gets
          a timely notification plus links to related coverage — keeping
          users current without making them go looking for the correction.
        </p>
      </Disclosure>
      <p class="project-description">
        Try the prototype: <Link
          aria-label="Adobe XD Prototype (opens a new window)"
          href="https://xd.adobe.com/view/3e5904f8-347a-412f-9f67-bb6cd05324f1-6b0a/"
          newTab
          underline>Adobe XD Prototype</Link
        >
      </p>
    </div>

    <div class="cs-hero-image">
      <Image
        format="jpeg"
        src={trustyFlow}
        alt="Full user flow of the Trusty app"
      />
    </div>

    <SectionHeading index="04" title="Feedback" id="feedback" />
    <div class="cs-section-body">
      <p class="project-description">
        The showcase drew real attention, even without a full round of user
        testing. Judges and peers pointed us toward more color, bigger and
        bolder type, and stricter spacing for accessibility. The tight
        timeline kept us from mapping a deeper flow or simulating real-world
        scenarios — but other teams&apos; approaches gave us plenty to bring
        into the next iteration.
      </p>
    </div>

    <div class="cs-footer-nav">
      <Link href="/" underline
        ><Icon name="arrow-left-long" />Go back to the home page</Link
      >
    </div>
  </div>
</Layout>
