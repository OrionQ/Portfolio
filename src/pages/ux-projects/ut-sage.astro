              width={1326}
              height={1500}
              quality={100}
              class="rounded-xl w-full h-auto object-contain max-w-full"
            />
          </div>
          <div class="flex-1 min-w-[min(280px,100%)] overflow-hidden">
            <Image
              src={sageOriginalIssueList}
              alt="Original UT Sage design - issue list"
