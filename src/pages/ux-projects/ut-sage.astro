import sageSharingFlow from "../../images/Sage_Updated_sharing_flow.png";
import facultyEvalByField from "../../images/faculty-eval-by-field.png";
import facultyEvalChatStep from "../../images/faculty-eval-chat-step.png";
import facultyEvalConfigureStep from "../../images/faculty-eval-configure-step.png";
import facultyEvalCustomize from "../../images/faculty-eval-customize.png";
import facultyEvalFileManagement from "../../images/faculty-eval-file-management.png";
import facultyEvalRecommendations from "../../images/faculty-eval-recommendations.png";
import facultyEvalThumbnail from "../../images/faculty-eval-thumbnail.png";
import facultyEvalTutorialModal from "../../images/faculty-eval-tutorial-modal.png";
import facultyEvalTutorialStep from "../../images/faculty-eval-tutorial-step.png";
---

<script>
  if (typeof window !== "undefined") {
    window.addEventListener("DOMContentLoaded", () => {
      const container = document.querySelector(".tabs-container");
      const indicator = document.getElementById("tab-indicator");

      const TAB_LAYOUT_MIN_PX = 4;

      const updateIndicator = (instant = false) => {
        const selected = container?.querySelector(
          '.tab-button[aria-selected="true"]',
        );
        if (
          !indicator ||
          !container ||
          !selected ||
          !(selected instanceof HTMLElement)
        )
          return;
        const measuredW = selected.offsetWidth;
        /* offsetWidth may be 0 on DOMContentLoaded; inline width would override CSS fallback. */
        if (measuredW < TAB_LAYOUT_MIN_PX) {
          return;
        }
        const leftPx = `${selected.offsetLeft}px`;
        const widthPx = `${measuredW}px`;

        if (instant) {
          indicator.style.transition = "none";
        }
        indicator.style.left = leftPx;
        indicator.style.width = widthPx;
        if (instant) {
          void indicator.offsetWidth;
          indicator.style.removeProperty("transition");
        }
      };

      const syncIndicatorLayout = () => updateIndicator(true);
      syncIndicatorLayout();
      requestAnimationFrame(syncIndicatorLayout);
      requestAnimationFrame(() => requestAnimationFrame(syncIndicatorLayout));

      window.addEventListener("resize", () => updateIndicator(false));

      document.fonts?.ready?.then(() => {
        updateIndicator(true);
      });

      container?.addEventListener("click", (e) => {
        const target = e.target;
        const btn =
          target instanceof Element
            ? target.closest("button[data-category]")
            : null;
        if (!(btn instanceof HTMLButtonElement)) return;
        const caseKey = btn.dataset.category;
        if (
          caseKey !== "redesignCase" &&
          caseKey !== "capstoneCase"
        )
          return;

        document.querySelectorAll('[role="tabpanel"]').forEach((panel) => {
          const id = panel.getAttribute("id");
          if (!id || !["redesignCase", "capstoneCase"].includes(id)) return;
          if (id === caseKey) {
            panel.removeAttribute("hidden");
          } else {
            panel.setAttribute("hidden", "");
          }
        });

        container?.querySelectorAll('[role="tab"]').forEach((button) => {
          button.setAttribute(
            "aria-selected",
            button.getAttribute("data-category") === caseKey ? "true" : "false",
          );
        });

        requestAnimationFrame(() => updateIndicator(false));
      });
    });
  }
</script>

<Layout title="UT Sage: Redesign + Tutor Evaluation | Xiaolei Qin's Portfolio">
  <div class="project-container">
    <CaseStudyHero
      kicker="Professional experience — Design system + AI evaluation"
      title="UT Sage"
      tagline="End-to-end product design for UT Austin's AI tutor platform: a shipped design-system redesign, and an AI-powered evaluation workflow for faculty."
    >
      <Fragment slot="meta">
        <MetaItem label="Learn more">
          <Link
            aria-label="UT Sage website (opens a new window)"
            href="https://provost.utexas.edu/the-office/academic-affairs/office-of-academic-technology/ut-sage/"
            newTab
            underline>ut-sage.utexas.edu</Link
          >
        </MetaItem>
      </Fragment>
    </CaseStudyHero>

    <div
      class="tabs-container flex flex-row flex-wrap mt-2 mb-4 min-w-0"
      role="tablist"
      aria-label="Choose case study"
    >
      <div class="tab-indicator" aria-hidden="true" id="tab-indicator"></div>
      <button
        type="button"
        aria-controls="redesignCase"
        aria-selected="true"
        class="tab-button min-w-0"
        data-category="redesignCase"
        id="tab-redesign-case"
        role="tab"
        ><h3>Case 1 — Product redesign</h3></button
      >
      <button
        type="button"
        aria-controls="capstoneCase"
        aria-selected="false"
        class="tab-button min-w-0"
        data-category="capstoneCase"
        id="tab-capstone-case"
        role="tab"
        ><h3>Case 2 — Faculty evaluation workflow</h3></button
      >
    </div>

    <div
      id="redesignCase"
      class="case-category"
      role="tabpanel"
      aria-labelledby="tab-redesign-case"
    >
      <div class="cs-hero-image">
        <Image
          src={sageConfigurePage}
          alt="UT Sage product sample page"
          width={1600}
          quality={100}
        />
      </div>

      <StatRow>
        <Stat value="25+" label="components in the new design system" />
        <Stat value="4 mo" label="from audit to shipped redesign" />
        <Stat value="AA" label="WCAG 2.2 accessibility target" />
      </StatRow>

      <div class="cs-section-body">
        <p class="project-description">
          UT Sage had just launched its beta to faculty and students
          campus-wide. The core features worked, but the interface was
          fragmented: inconsistent components, accessibility gaps, and
          missed details left people confused. As the sole designer, my
          goal was a unified, accessible experience that could scale as the
          platform grew.
        </p>
      </div>

      <SectionHeading index="01" title="Where do I start?" id="where-do-i-start" />
      <div class="cs-section-body">
        <p class="project-description">
          Testing the platform surfaced inconsistent icons, font sizes, and
          styles across pages, plus real accessibility gaps — poor
          contrast, small text, no keyboard navigation. That was the
          moment I decided to rebuild the design system from scratch.
        </p>
        <div class="cs-gallery">
          <Image
            src={sageOriginalDesign1}
            alt="Original UT Sage design - issue 1"
            width={420}
            quality={100}
          />
          <Image
            src={sageOriginalDesign2}
            alt="Original UT Sage design - issue 2"
            width={420}
            quality={100}
          />
          <Image
            src={sageOriginalIssueList}
            alt="Original UT Sage design - issue list"
            width={420}
            quality={100}
          />
        </div>
      </div>

      <SectionHeading
        index="02"
        title="Feedback from users & stakeholders"
        id="get-feedback-from-the-users-and-stakeholders"
      />
      <div class="cs-section-body">
        <p class="project-description">
          Before jumping to solutions, I learned the existing design
          language: talked with the previous designer about her rationale,
          pulled lo-fi sketches from my manager to trace the product&apos;s
          evolution, and stayed in a regular feedback loop as she relayed
          insight from users and researchers.
        </p>
        <div class="cs-gallery">
          <Image src={sageLofi} alt="UT Sage lo-fi design" width={500} quality={100} />
          <Image
            src={sageOriginalToggle}
            alt="UT Sage original toggle design"
            width={500}
            quality={100}
          />
        </div>
      </div>

      <SectionHeading
        index="03"
        title="Build the new design system"
        id="build-the-new-design-system"
      />
      <div class="cs-section-body">
        <p class="project-description">
          25+ standardized components, WCAG 2.2 AA accessibility baked in
          at the component level, and Figma tokens from day one — built to
          be scalable and future-proof, not a one-time patch.
        </p>
        <div class="cs-gallery">
          <Image src={sageFoundations} alt="UT Sage foundations" width={500} quality={100} />
          <Image src={sageButtons} alt="UT Sage buttons" width={500} quality={100} />
          <Image
            src={sageExampleComponents}
            alt="UT Sage example components"
            width={500}
            quality={100}
          />
        </div>
      </div>

      <SectionHeading index="04" title="Recreate the pages" id="recreate-the-pages" />
      <div class="cs-section-body">
        <p class="project-description">
          Using the new system, I iterated quickly page by page, updating
          components as needed. My design-engineering background helped —
          I worked closely with the lead front-end engineer, designing
          within real technical constraints instead of around them.
        </p>
        <div class="cs-card-grid">
          <Card cardType="secondary">
            <h3>Toggle redesign</h3>
            <Image
              src={sageToggleIteration}
              alt="UT Sage toggle iteration"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Edit page</h3>
            <Image
              src={sageEditPage}
              alt="UT Sage edit page"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Home screen</h3>
            <Image
              src={sageHomepageTransition}
              alt="UT Sage homepage transition"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Help center</h3>
            <Image
              src={sageHelpCenterPage}
              alt="UT Sage help center page"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
        </div>
        <Disclosure title="Example sharing flow, with redlines" className="cs-detail">
          <Image
            src={sageSharingFlow}
            alt="UT Sage sharing flow"
            width={900}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover w-full"
          />
          <p class="project-description mt-3">
            Updated sharing flow with more accessible font sizes and colors.
          </p>
        </Disclosure>
      </div>

      <SectionHeading
        index="05"
        title="Validation & results"
        id="validation-and-results"
      />
      <div class="cs-section-body">
        <p class="project-description">
          After four months, I delivered a more accessible, unified UT Sage
          prototype. The engineering team used the design system to rebuild
          pages faster, with far better consistency.
        </p>
        <div class="cs-card-grid">
          <Card cardType="secondary">
            <h3>Home screen</h3>
            <Image
              src={sageHomepageProduction}
              alt="UT Sage homepage production"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Edit screen</h3>
            <Image
              src={sageEditPageProduction}
              alt="UT Sage edit page production"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary" className="md:col-span-2">
            <h3>Chat screen</h3>
            <Image
              src={sageChatPageProduction}
              alt="UT Sage chat page production"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
        </div>
      </div>

      <SectionHeading index="06" title="Outcomes" id="outcomes" />
      <div class="cs-section-body">
        <p class="project-description">
          This redesign turned UT Sage from a half-finished beta into a
          coherent, accessible educational platform.
        </p>
        <div class="cs-card-grid">
          <Card title="Accessibility" cardType="secondary">
            <p>
              WCAG 2.2 AA target across all components — color contrast,
              font sizing, keyboard navigation.
            </p>
          </Card>
          <Card title="Consistency" cardType="secondary">
            <p>
              A 25+ component design system with Figma tokens, consistent
              across the whole platform.
            </p>
          </Card>
          <Card title="Developer efficiency" cardType="secondary">
            <p>
              Engineering now builds pages significantly faster using the
              systematized components.
            </p>
          </Card>
          <Card title="Design sustainability" cardType="secondary">
            <p>New features can be designed quickly on top of a robust system.</p>
          </Card>
        </div>
      </div>

      <SectionHeading
        index="07"
        title="Reflection & next steps"
        id="reflection-and-next-steps"
      />
      <div class="cs-section-body">
        <p class="project-description">
          A solid design system turned out to be the difference between
          scalable, high-quality results and constant rework — and my
          design-engineering background helped bridge design and
          development into something practical. If I did it again, I would
          have pushed for more detailed feedback from users and
          stakeholders earlier, to stress-test some of the flow decisions
          sooner.
        </p>
        <p class="cs-subhead">Next steps</p>
        <ul class="flex flex-col gap-2 project-description">
          <li>Dark mode, to improve accessibility and give users a choice.</li>
          <li>Broader user testing across diverse faculty and student populations.</li>
          <li>Iterative improvements as testing surfaces new insight.</li>
        </ul>
      </div>
    </div>

    <div
      id="capstoneCase"
      class="case-category"
      role="tabpanel"
      aria-labelledby="tab-capstone-case"
      hidden
    >
      <div class="cs-hero-image">
        <Image
          format="png"
          src={facultyEvalRecommendations}
          alt="Tutor evaluation dashboard — key findings, overview, and suggestions & recommendations"
          width={1600}
          quality={100}
        />
      </div>

      <StatRow>
        <Stat value="8" label="response-quality evaluation dimensions" />
        <Stat value="7" label="instructional tutoring-skill dimensions" />
      </StatRow>

      <div class="cs-section-body">
        <p class="project-description">
          UT Sage made it easy for faculty to configure AI tutors — but gave
          them no reliable way to test quality, misconceptions, or pedagogy
          before exposing students to a tutor, and no onboarding to learn
          the evaluation tool.
        </p>
      </div>

      <SectionHeading index="01" title="Goal" id="capstone-goal" />
      <div class="cs-section-body">
        <p class="project-description">
          <strong>Problem:</strong> faculty could scaffold and publish tutors,
          but had no repeatable way to simulate learners, stress-test tutoring
          behavior, or reconcile configuration with pedagogical outcomes.
        </p>
        <div class="cs-card-grid">
          <Card title="How might we?" cardType="secondary">
            <p>
              Help faculty confidently assess and refine tutor
              configurations before deployment — surfacing observable
              evidence, explainable ratings, and updates they can approve?
            </p>
          </Card>
          <Card title="Design goal" cardType="secondary">
            <p>
              Pair approachable onboarding that builds mental models of each
              config field with a dashboard that routes faculty from
              high-level warnings down to granular checks and examples.
            </p>
          </Card>
        </div>
      </div>

      <SectionHeading
        index="02"
        title="Research & evaluation framework"
        id="capstone-research"
      />
      <div class="cs-section-body">
        <p class="project-description">
          I paired secondary research with historical user-interview data
          from existing UT Sage studies, then translated AI-evaluation
          literature into an instructor-readable scorecard anchored in
          classroom teaching moves.
        </p>
        <Disclosure title="8 evaluation dimensions — response quality" className="cs-detail">
          <ul class="list-disc pl-6 space-y-2 project-description">
            <li><strong>D1 Instruction-following</strong> — honors faculty special instructions.</li>
            <li><strong>D2 Truthfulness</strong> — accurate explanations; no hallucinated content.</li>
            <li><strong>D3 Style / tone</strong> — warm yet academically rigorous.</li>
            <li><strong>D4 Visual reasoning</strong> — interprets diagrams or graphs.</li>
            <li><strong>D5 Visual perception</strong> — reads visual inputs learners share.</li>
            <li><strong>D6 Calibration</strong> — pacing fits the learner profile.</li>
            <li><strong>D7 Conciseness</strong> — replies stay appropriately scoped.</li>
            <li><strong>D8 Emotional responsiveness</strong> — addresses frustration constructively.</li>
          </ul>
        </Disclosure>
        <Disclosure title="7 tutoring skills — instructional behaviors" className="cs-detail">
          <ul class="list-disc pl-6 space-y-2 project-description">
            <li><strong>T1</strong> Identifies misconceptions explicitly.</li>
            <li><strong>T2</strong> Guides with questions instead of giving answers outright.</li>
            <li><strong>T3</strong> Uses examples and analogies to demystify ideas.</li>
            <li><strong>T4</strong> Offers alternate solution paths.</li>
            <li><strong>T5</strong> Scaffolds step-by-step when problems are dense.</li>
            <li><strong>T6</strong> Recalls syllabus or uploaded resources when relevant.</li>
            <li><strong>T7</strong> Judges correct/incorrect steps in learner work accurately.</li>
          </ul>
        </Disclosure>
      </div>

      <SectionHeading
        index="03"
        title="Prototyping"
        id="capstone-prototyping"
      />
      <div class="cs-section-body">
        <p class="project-description">
          I iterated in Figma on two intertwined surfaces: contextual
          tutorial overlays explaining how Create, Configure, and Train map
          tutor memory, plus a consolidated evaluation concept that
          surfaced key findings before the detail tabs.
        </p>
        <div class="cs-card-grid">
          <Card cardType="secondary">
            <h3>Welcome modal</h3>
            <p>Sets expectations and scope guardrails.</p>
            <Image
              format="png"
              src={facultyEvalTutorialModal}
              alt="Welcome to Create Your UT Sage Tutor modal"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Orientation step</h3>
            <p>Contextualizes Create, Configure, and Train.</p>
            <Image
              format="png"
              src={facultyEvalTutorialStep}
              alt="Tutorial explaining Create Configure and Train sections"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Chat scaffolding</h3>
            <p>An alternative to typing every field manually.</p>
            <Image
              format="png"
              src={facultyEvalChatStep}
              alt="Tutorial tooltip on tutor creation chat syncing fields"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Configure cue</h3>
            <p>Anchors fields that feed calibration logic.</p>
            <Image
              format="png"
              src={facultyEvalConfigureStep}
              alt="Tutorial tooltip on learner characteristics in Configure tab"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
        </div>
        <p class="cs-subhead">Early evaluation dashboard</p>
        <p class="project-description">How the AI surfaces cross-field risks to faculty.</p>
        <div class="cs-hero-image">
          <Image
            format="png"
            src={facultyEvalThumbnail}
            alt="Full tutor evaluation concept showing key findings and overview"
            width={1400}
            quality={100}
          />
        </div>
      </div>

      <SectionHeading
        index="04"
        title="Faculty research — usability findings"
        id="capstone-interviews"
      />
      <div class="cs-section-body">
        <p class="project-description">
          Moderated remote think-alouds (30–45 min) with UT Austin faculty
          and instructional partners, evaluating two Figma prototypes: the
          guided tutorial overlay and the tutor evaluation UI.
        </p>
        <div class="cs-card-grid">
          <Card cardType="secondary">
            <h3>Tutorial & language</h3>
            <p>
              Confusing language didn&apos;t support the learning process;
              several participants wanted more concrete examples.
            </p>
          </Card>
          <Card cardType="secondary">
            <h3>Cognitive load</h3>
            <p>
              Empty states jumped straight into exhaustive detail — faculty
              felt overwhelmed by the volume of information.
            </p>
          </Card>
          <Card cardType="secondary">
            <h3>Fitness of the model</h3>
            <p>Faculty wanted a way to customize evaluation prompts to fit their needs.</p>
          </Card>
          <Card cardType="secondary">
            <h3>Surfacing severity</h3>
            <p>
              Color coding helped, but needed an accessibility pass and
              stronger signal for critical issues.
            </p>
          </Card>
          <Card cardType="secondary" className="md:col-span-2">
            <h3>Evidence & authenticity</h3>
            <p>
              Auto-fix and heavy nudging need visible scope/consent
              boundaries that protect instructor-authored ideas.
            </p>
          </Card>
        </div>
      </div>

      <SectionHeading
        index="05"
        title="Iteration — reduce information overload"
        id="capstone-iteration"
      />
      <div class="cs-section-body">
        <p class="project-description">
          Research converged on staging complexity: summarize risk first,
          funnel faculty into prioritized remediations, and only then
          expose field-by-field adjudication or bespoke simulation prompts.
          Each tab below isolates a workload to prevent the &ldquo;everything
          at once&rdquo; fatigue moderated sessions flagged, while keeping
          cross-links for deep dives intact.
        </p>
        <div class="cs-card-grid">
          <Card cardType="secondary">
            <h3>Suggestions & recommendations</h3>
            <Image
              format="png"
              src={facultyEvalRecommendations}
              alt="Tutor Evaluation tab showing key findings overview and suggestion cards"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Evaluation by field</h3>
            <Image
              format="png"
              src={facultyEvalByField}
              alt="Evaluation by field table"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>File management</h3>
            <Image
              format="png"
              src={facultyEvalFileManagement}
              alt="File management tab listing syllabus and documents with statuses"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Customize evaluation</h3>
            <p>Added feature, from faculty feedback.</p>
            <Image
              format="png"
              src={facultyEvalCustomize}
              alt="Customize evaluation tab for additional benchmark questions"
              width={500}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
        </div>
      </div>

      <SectionHeading index="06" title="Future directions" id="capstone-future" />
      <div class="cs-section-body">
        <ul class="list-disc pl-6 space-y-2 project-description">
          <li>
            Ship tutorial copy that ties highlight, narration, and live UI
            state together, with concrete examples for each config field.
          </li>
          <li>
            Build explainable labeling for simulations (simulated-learner
            transcripts vs. telemetry), and rethink Auto-fix so faculty stay
            authors of misconception content unless they opt in.
          </li>
          <li>
            Follow-up moderated tests with Humanities and STEM instructors
            post-launch; extend benchmark suites per discipline as adoption
            grows.
          </li>
        </ul>
