<script>
  if (typeof window !== "undefined") {
    window.addEventListener("DOMContentLoaded", () => {
      const container = document.querySelector(".tabs-container");
      const indicator = document.getElementById("tab-indicator");

      const TAB_LAYOUT_MIN_PX = 4;

      const updateIndicator = (instant = false) => {
        const selected = container?.querySelector(
          '.tab-button[aria-selected="true"]',
        );
        if (
          !indicator ||
          !container ||
          !selected ||
          !(selected instanceof HTMLElement)
        )
          return;
        const measuredW = selected.offsetWidth;
        /* offsetWidth may be 0 on DOMContentLoaded; inline width would override CSS fallback. */
        if (measuredW < TAB_LAYOUT_MIN_PX) {
          return;
        }
        const leftPx = `${selected.offsetLeft}px`;
        const widthPx = `${measuredW}px`;

        if (instant) {
          indicator.style.transition = "none";
        }
        indicator.style.left = leftPx;
        indicator.style.width = widthPx;
        if (instant) {
          void indicator.offsetWidth;
          indicator.style.removeProperty("transition");
        }
      };

      const syncIndicatorLayout = () => updateIndicator(true);
      syncIndicatorLayout();
      requestAnimationFrame(syncIndicatorLayout);
      requestAnimationFrame(() => requestAnimationFrame(syncIndicatorLayout));

      window.addEventListener("resize", () => updateIndicator(false));

      document.fonts?.ready?.then(() => {
        updateIndicator(true);
      });

      container?.addEventListener("click", (e) => {
        const target = e.target;
        const btn =
          target instanceof Element
            ? target.closest("button[data-category]")
            : null;
        if (!(btn instanceof HTMLButtonElement)) return;
        const caseKey = btn.dataset.category;
        if (
          caseKey !== "redesignCase" &&
          caseKey !== "capstoneCase"
        )
          return;

        document.querySelectorAll('[role="tabpanel"]').forEach((panel) => {
          const id = panel.getAttribute("id");
          if (!id || !["redesignCase", "capstoneCase"].includes(id)) return;
          if (id === caseKey) {
            panel.removeAttribute("hidden");
          } else {
            panel.setAttribute("hidden", "");
          }
        });

        container?.querySelectorAll('[role="tab"]').forEach((button) => {
          button.setAttribute(
            "aria-selected",
            button.getAttribute("data-category") === caseKey ? "true" : "false",
          );
        });

        requestAnimationFrame(() => updateIndicator(false));
      });
    });
  }
</script>

<Layout title="UT Sage: Redesign + Tutor Evaluation | Xiaolei Qin's Portfolio">
  <div class="project-container">
