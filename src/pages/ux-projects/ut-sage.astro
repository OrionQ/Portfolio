import { Image } from "astro:assets";
import Card from "../../components/card/Card.astro";
import CaseStudyHero from "../../components/case-study/CaseStudyHero.astro";
import MetaItem from "../../components/case-study/MetaItem.astro";
import SectionHeading from "../../components/case-study/SectionHeading.astro";
import Stat from "../../components/case-study/Stat.astro";
import StatRow from "../../components/case-study/StatRow.astro";
import Link from "../../components/link/Link.astro";
import Layout from "../../layouts/Layout.astro";
import "./ux-projects.css";

import sageButtons from "../../images/Sage_Button_redesign.png";
import sageChatPageProduction from "../../images/Sage_Chat_screen_product.png";
import sageConfigurePage from "../../images/Sage_Edit_page.png";
import sageEditPageProduction from "../../images/Sage_Edit_screen_product.png";
import sageEditPage from "../../images/Sage_Edit_transition.png";
import sageExampleComponents from "../../images/Sage_Example_components.png";
import sageFoundations from "../../images/Sage_Foundations.png";
import sageHelpCenterPage from "../../images/Sage_Help_center_transition.png";
import sageHomepageProduction from "../../images/Sage_Home_screen_product.png";
import sageHomepageTransition from "../../images/Sage_Home_screen_transition.png";
import sageLofi from "../../images/Sage_Lofi.png";
import sageOriginalDesign1 from "../../images/Sage_Original_issue_1.png";
import sageOriginalDesign2 from "../../images/Sage_Original_issue_2.png";
import sageOriginalIssueList from "../../images/Sage_Original_issue_list.png";
import sageOriginalToggle from "../../images/Sage_Toggle_issue.png";
import sageToggleIteration from "../../images/Sage_Toggle_redesign.png";
import sageSharingFlow from "../../images/Sage_Updated_sharing_flow.png";
import facultyEvalByField from "../../images/faculty-eval-by-field.png";
import facultyEvalChatStep from "../../images/faculty-eval-chat-step.png";
import facultyEvalConfigureStep from "../../images/faculty-eval-configure-step.png";
import facultyEvalCustomize from "../../images/faculty-eval-customize.png";
import facultyEvalFileManagement from "../../images/faculty-eval-file-management.png";
import facultyEvalRecommendations from "../../images/faculty-eval-recommendations.png";
import facultyEvalThumbnail from "../../images/faculty-eval-thumbnail.png";
import facultyEvalTutorialModal from "../../images/faculty-eval-tutorial-modal.png";
import facultyEvalTutorialStep from "../../images/faculty-eval-tutorial-step.png";
---

<script>
  if (typeof window !== "undefined") {
    window.addEventListener("DOMContentLoaded", () => {
      const container = document.querySelector(".tabs-container");
      const indicator = document.getElementById("tab-indicator");

      const TAB_LAYOUT_MIN_PX = 4;

      const updateIndicator = (instant = false) => {
        const selected = container?.querySelector(
          '.tab-button[aria-selected="true"]',
        );
        if (
          !indicator ||
          !container ||
          !selected ||
          !(selected instanceof HTMLElement)
        )
          return;
        const measuredW = selected.offsetWidth;
        /* offsetWidth may be 0 on DOMContentLoaded; inline width would override CSS fallback. */
        if (measuredW < TAB_LAYOUT_MIN_PX) {
          return;
        }
        const leftPx = `${selected.offsetLeft}px`;
        const widthPx = `${measuredW}px`;

        if (instant) {
          indicator.style.transition = "none";
        }
        indicator.style.left = leftPx;
        indicator.style.width = widthPx;
        if (instant) {
          void indicator.offsetWidth;
          indicator.style.removeProperty("transition");
        }
      };

      const syncIndicatorLayout = () => updateIndicator(true);
      syncIndicatorLayout();
      requestAnimationFrame(syncIndicatorLayout);
      requestAnimationFrame(() => requestAnimationFrame(syncIndicatorLayout));

      window.addEventListener("resize", () => updateIndicator(false));

      document.fonts?.ready?.then(() => {
        updateIndicator(true);
      });

      container?.addEventListener("click", (e) => {
        const target = e.target;
        const btn =
          target instanceof Element
            ? target.closest("button[data-category]")
            : null;
        if (!(btn instanceof HTMLButtonElement)) return;
        const caseKey = btn.dataset.category;
        if (
          caseKey !== "redesignCase" &&
          caseKey !== "capstoneCase"
        )
          return;

        document.querySelectorAll('[role="tabpanel"]').forEach((panel) => {
          const id = panel.getAttribute("id");
          if (!id || !["redesignCase", "capstoneCase"].includes(id)) return;
          if (id === caseKey) {
            panel.removeAttribute("hidden");
          } else {
            panel.setAttribute("hidden", "");
          }
        });

        container?.querySelectorAll('[role="tab"]').forEach((button) => {
          button.setAttribute(
            "aria-selected",
            button.getAttribute("data-category") === caseKey ? "true" : "false",
          );
        });

        requestAnimationFrame(() => updateIndicator(false));
      });
    });
  }
</script>

<Layout title="UT Sage: Redesign + Tutor Evaluation | Xiaolei Qin's Portfolio">
  <div class="project-container">
    <CaseStudyHero
      kicker="Professional experience — Design system + AI evaluation"
      title="UT Sage"
      tagline="Product design for UT Austin's AI tutor platform: a shipped design-system redesign, and an AI evaluation workflow for faculty."
    >
      <Fragment slot="meta">
        <MetaItem label="Learn more">
          <Link
            aria-label="UT Sage website (opens a new window)"
            href="https://provost.utexas.edu/the-office/academic-affairs/office-of-academic-technology/ut-sage/"
            newTab
            underline>ut-sage.utexas.edu</Link
          >
        </MetaItem>
      </Fragment>
    </CaseStudyHero>

    <div
      class="tabs-container flex flex-row flex-wrap mt-2 mb-4 min-w-0"
      role="tablist"
      aria-label="Choose case study"
    >
      <div class="tab-indicator" aria-hidden="true" id="tab-indicator"></div>
      <button
        type="button"
        aria-controls="redesignCase"
        aria-selected="true"
        class="tab-button min-w-0"
        data-category="redesignCase"
        id="tab-redesign-case"
        role="tab"
        ><h3>Case 1 — Product redesign</h3></button
      >
      <button
        type="button"
        aria-controls="capstoneCase"
        aria-selected="false"
        class="tab-button min-w-0"
        data-category="capstoneCase"
        id="tab-capstone-case"
        role="tab"
        ><h3>Case 2 — Faculty evaluation workflow</h3></button
      >
    </div>

    <div
      id="redesignCase"
      class="case-category"
      role="tabpanel"
      aria-labelledby="tab-redesign-case"
    >
      <div class="cs-hero-image">
        <Image
          src={sageConfigurePage}
          alt="UT Sage product sample page"
          width={1800}
          quality={100}
        />
      </div>

      <StatRow>
        <Stat value="25+" label="components in the new design system" />
        <Stat value="4 mo" label="from audit to shipped redesign" />
        <Stat value="AA" label="WCAG 2.2 accessibility target" />
      </StatRow>

      <div class="cs-section-body">
        <p class="project-description">
          <strong>Problem:</strong> UT Sage had just launched. Core features
          worked, but the interface was fragmented — inconsistent
          components, accessibility gaps, confused users. As the sole
          designer, I needed a unified experience that could scale.
        </p>
      </div>

      <SectionHeading index="01" title="Where do I start?" id="where-do-i-start" />
      <div class="cs-section-body">
        <p class="project-description">
          I tested the platform myself first. Inconsistent icons, fonts,
          styles. Poor contrast, small text, no keyboard navigation. That
          was the moment I decided to rebuild the design system from
          scratch.
        </p>
        <div class="cs-gallery">
          <Image
            src={sageOriginalDesign1}
            alt="Original UT Sage design - issue 1"
            width={800}
            quality={100}
          />
          <Image
            src={sageOriginalDesign2}
            alt="Original UT Sage design - issue 2"
            width={800}
            quality={100}
          />
          <Image
            src={sageOriginalIssueList}
            alt="Original UT Sage design - issue list"
            width={800}
            quality={100}
          />
        </div>
      </div>

      <SectionHeading
        index="02"
        title="Feedback from users & stakeholders"
        id="get-feedback-from-the-users-and-stakeholders"
      />
      <div class="cs-section-body">
        <p class="project-description">
          Before jumping to solutions, I learned the existing design
          language: talked with the previous designer, pulled old sketches
          from my manager, and stayed in a regular loop with users and
          researchers.
        </p>
        <div class="cs-gallery">
          <Image src={sageLofi} alt="UT Sage lo-fi design" width={900} quality={100} />
          <Image
            src={sageOriginalToggle}
            alt="UT Sage original toggle design"
            width={900}
            quality={100}
          />
        </div>
      </div>

      <SectionHeading
        index="03"
        title="Build the new design system"
        id="build-the-new-design-system"
      />
      <div class="cs-section-body">
        <p class="project-description">
          <strong>Solution:</strong> 25+ standardized components. WCAG 2.2
          AA baked in from the start. Figma tokens from day one — built to
          scale, not patch.
        </p>
        <div class="cs-gallery">
          <Image src={sageFoundations} alt="UT Sage foundations" width={900} quality={100} />
          <Image src={sageButtons} alt="UT Sage buttons" width={900} quality={100} />
          <Image
            src={sageExampleComponents}
            alt="UT Sage example components"
            width={900}
            quality={100}
          />
        </div>
      </div>

      <SectionHeading index="04" title="Recreate the pages" id="recreate-the-pages" />
      <div class="cs-section-body">
        <p class="project-description">
          I iterated page by page with the new system. My design-engineering
          background helped: I worked closely with the lead engineer,
          designing within real technical limits instead of around them.
        </p>
        <div class="cs-card-grid">
          <Card cardType="secondary">
            <h3>Toggle redesign</h3>
            <Image
              src={sageToggleIteration}
              alt="UT Sage toggle iteration"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Edit page</h3>
            <Image
              src={sageEditPage}
              alt="UT Sage edit page"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Home screen</h3>
            <Image
              src={sageHomepageTransition}
              alt="UT Sage homepage transition"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Help center</h3>
            <Image
              src={sageHelpCenterPage}
              alt="UT Sage help center page"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
        </div>
        <div class="cs-inline-detail">
          <p class="cs-subhead">Example sharing flow, with redlines</p>
          <Image
            src={sageSharingFlow}
            alt="UT Sage sharing flow"
            width={1300}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover w-full"
          />
          <p class="project-description">
            Bigger font sizes, more accessible colors.
          </p>
        </div>
      </div>

      <SectionHeading
        index="05"
        title="Validation & results"
        id="validation-and-results"
      />
      <div class="cs-section-body">
        <p class="project-description">
          Four months later: a more accessible, unified prototype.
          Engineering rebuilt pages faster, and far more consistently.
        </p>
        <div class="cs-card-grid">
          <Card cardType="secondary">
            <h3>Home screen</h3>
            <Image
              src={sageHomepageProduction}
              alt="UT Sage homepage production"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Edit screen</h3>
            <Image
              src={sageEditPageProduction}
              alt="UT Sage edit page production"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary" className="md:col-span-2">
            <h3>Chat screen</h3>
            <Image
              src={sageChatPageProduction}
              alt="UT Sage chat page production"
              width={1300}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
        </div>
      </div>

      <SectionHeading index="06" title="Outcomes" id="outcomes" />
      <div class="cs-section-body">
        <p class="project-description">
          UT Sage went from a half-finished beta to a coherent, accessible
          platform.
        </p>
        <div class="cs-card-grid">
          <Card title="Accessibility" cardType="secondary">
            <p>WCAG 2.2 AA across every component.</p>
          </Card>
          <Card title="Consistency" cardType="secondary">
            <p>25+ components, one design system, Figma tokens throughout.</p>
          </Card>
          <Card title="Developer efficiency" cardType="secondary">
            <p>Engineering builds pages significantly faster now.</p>
          </Card>
          <Card title="Design sustainability" cardType="secondary">
            <p>New features design quickly on top of a robust system.</p>
          </Card>
        </div>
      </div>

      <SectionHeading
        index="07"
        title="Reflection & next steps"
        id="reflection-and-next-steps"
      />
      <div class="cs-section-body">
        <p class="project-description">
          A solid design system made the difference between scalable
          results and constant rework. If I did it again, I&apos;d push for
          more user feedback earlier — to stress-test flow decisions
          sooner.
        </p>
        <p class="cs-subhead">Next steps</p>
        <ul class="flex flex-col gap-2 project-description">
          <li>Dark mode, to improve accessibility and give users a choice.</li>
          <li>Broader user testing across diverse faculty and student populations.</li>
          <li>Iterative improvements as testing surfaces new insight.</li>
        </ul>
      </div>
    </div>

    <div
      id="capstoneCase"
      class="case-category"
      role="tabpanel"
      aria-labelledby="tab-capstone-case"
      hidden
    >
      <div class="cs-hero-image">
        <Image
          format="png"
          src={facultyEvalRecommendations}
          alt="Tutor evaluation dashboard — key findings, overview, and suggestions & recommendations"
          width={1800}
          quality={100}
        />
      </div>

      <StatRow>
        <Stat value="8" label="response-quality evaluation dimensions" />
        <Stat value="7" label="instructional tutoring-skill dimensions" />
      </StatRow>

      <div class="cs-section-body">
        <p class="project-description">
          <strong>Problem:</strong> faculty could build AI tutors, but
          couldn&apos;t easily test one before showing it to students. No
          way to check quality or catch mistakes. No onboarding, either.
        </p>
      </div>

      <SectionHeading index="01" title="Goal" id="capstone-goal" />
      <div class="cs-section-body">
        <p class="project-description">
          Faculty could publish a tutor, but had no repeatable way to test
          how it would actually teach.
        </p>
        <div class="cs-card-grid">
          <Card title="How might we?" cardType="secondary">
            <p>
              Help faculty confidently check and refine a tutor before it
              goes live — with clear evidence and changes they can approve?
            </p>
          </Card>
          <Card title="Design goal" cardType="secondary">
            <p>
              Simple onboarding that explains each setting, plus a
              dashboard that goes from high-level warnings down to specific
              fixes.
            </p>
          </Card>
        </div>
      </div>

      <SectionHeading
        index="02"
        title="Research & evaluation framework"
        id="capstone-research"
      />
      <div class="cs-section-body">
        <p class="project-description">
          I combined past UT Sage research with AI-evaluation literature,
          then turned it into a scorecard any instructor could read —
          grounded in real classroom teaching moves.
        </p>
        <div class="cs-card-grid">
          <Card title="8 evaluation dimensions — response quality" cardType="secondary">
            <ul class="list-disc pl-5 space-y-1.5">
              <li><strong>D1 Instruction-following</strong> — honors special instructions.</li>
              <li><strong>D2 Truthfulness</strong> — no hallucinated content.</li>
              <li><strong>D3 Style / tone</strong> — warm yet academically rigorous.</li>
              <li><strong>D4 Visual reasoning</strong> — interprets diagrams or graphs.</li>
              <li><strong>D5 Visual perception</strong> — reads visual inputs learners share.</li>
              <li><strong>D6 Calibration</strong> — pacing fits the learner.</li>
              <li><strong>D7 Conciseness</strong> — replies stay scoped.</li>
              <li><strong>D8 Emotional responsiveness</strong> — addresses frustration constructively.</li>
            </ul>
          </Card>
          <Card title="7 tutoring skills — instructional behaviors" cardType="secondary">
            <ul class="list-disc pl-5 space-y-1.5">
              <li><strong>T1</strong> Identifies misconceptions explicitly.</li>
              <li><strong>T2</strong> Guides with questions, not answers.</li>
              <li><strong>T3</strong> Uses examples and analogies.</li>
              <li><strong>T4</strong> Offers alternate solution paths.</li>
              <li><strong>T5</strong> Scaffolds step-by-step when problems are dense.</li>
              <li><strong>T6</strong> Recalls syllabus or uploaded resources.</li>
              <li><strong>T7</strong> Judges correct/incorrect steps accurately.</li>
            </ul>
          </Card>
        </div>
      </div>

      <SectionHeading
        index="03"
        title="Prototyping"
        id="capstone-prototyping"
      />
      <div class="cs-section-body">
        <p class="project-description">
          Two surfaces, built together in Figma: tutorial overlays that
          explain Create, Configure, and Train, and an evaluation view that
          leads with key findings before the details.
        </p>
        <div class="cs-card-grid">
          <Card cardType="secondary">
            <h3>Welcome modal</h3>
            <p>Sets expectations and scope guardrails.</p>
            <Image
              format="png"
              src={facultyEvalTutorialModal}
              alt="Welcome to Create Your UT Sage Tutor modal"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Orientation step</h3>
            <p>Contextualizes Create, Configure, and Train.</p>
            <Image
              format="png"
              src={facultyEvalTutorialStep}
              alt="Tutorial explaining Create Configure and Train sections"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Chat scaffolding</h3>
            <p>An alternative to typing every field manually.</p>
            <Image
              format="png"
              src={facultyEvalChatStep}
              alt="Tutorial tooltip on tutor creation chat syncing fields"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Configure cue</h3>
            <p>Points to the fields that shape how the tutor calibrates.</p>
            <Image
              format="png"
              src={facultyEvalConfigureStep}
              alt="Tutorial tooltip on learner characteristics in Configure tab"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
        </div>
        <p class="cs-subhead">Early evaluation dashboard</p>
        <p class="project-description">How the AI surfaces cross-field risks to faculty.</p>
        <div class="cs-hero-image">
          <Image
            format="png"
            src={facultyEvalThumbnail}
            alt="Full tutor evaluation concept showing key findings and overview"
            width={1600}
            quality={100}
          />
        </div>
      </div>

      <SectionHeading
        index="04"
        title="Faculty research — usability findings"
        id="capstone-interviews"
      />
      <div class="cs-section-body">
        <p class="project-description">
          30–45 minute remote sessions with UT Austin faculty, thinking
          aloud through two Figma prototypes: the tutorial overlay and the
          evaluation UI.
        </p>
        <div class="cs-card-grid">
          <Card cardType="secondary">
            <h3>Tutorial & language</h3>
            <p>Confusing wording didn&apos;t help. People wanted concrete examples.</p>
          </Card>
          <Card cardType="secondary">
            <h3>Cognitive load</h3>
            <p>Too much detail, too soon. Faculty felt overwhelmed.</p>
          </Card>
          <Card cardType="secondary">
            <h3>Fitness of the model</h3>
            <p>Faculty wanted to customize evaluation prompts themselves.</p>
          </Card>
          <Card cardType="secondary">
            <h3>Surfacing severity</h3>
            <p>Color coding helped, but critical issues needed a stronger signal.</p>
          </Card>
          <Card cardType="secondary" className="md:col-span-2">
            <h3>Evidence & authenticity</h3>
            <p>Auto-fix felt risky. Faculty want to stay the author of their own tutor.</p>
          </Card>
        </div>
      </div>

      <SectionHeading
        index="05"
        title="Iteration — reduce information overload"
        id="capstone-iteration"
      />
      <div class="cs-section-body">
        <p class="project-description">
          <strong>Solution:</strong> summarize risk first, then let faculty
          drill down. Each tab below handles one job, so nothing hits them
          all at once.
        </p>
        <div class="cs-card-grid">
          <Card cardType="secondary">
            <h3>Suggestions & recommendations</h3>
            <Image
              format="png"
              src={facultyEvalRecommendations}
              alt="Tutor Evaluation tab showing key findings overview and suggestion cards"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Evaluation by field</h3>
            <Image
              format="png"
              src={facultyEvalByField}
              alt="Evaluation by field table"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>File management</h3>
            <Image
              format="png"
              src={facultyEvalFileManagement}
              alt="File management tab listing syllabus and documents with statuses"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
          <Card cardType="secondary">
            <h3>Customize evaluation</h3>
            <p>Added feature, from faculty feedback.</p>
            <Image
              format="png"
              src={facultyEvalCustomize}
              alt="Customize evaluation tab for additional benchmark questions"
              width={900}
              quality={100}
              class="rounded-[var(--border-radius)] object-cover w-full mt-2"
            />
          </Card>
        </div>
      </div>

      <SectionHeading index="06" title="Future directions" id="capstone-future" />
      <div class="cs-section-body">
        <ul class="list-disc pl-6 space-y-2 project-description">
          <li>Tutorial copy with real examples for every config field, tied to what&apos;s on screen.</li>
          <li>Clear labels on simulated results, and an opt-in Auto-fix so faculty stay in control.</li>
          <li>More testing with Humanities and STEM instructors after launch.</li>
        </ul>
      </div>
    </div>

    <div class="cs-footer-nav">
      <Link href="/" underline><Icon name="arrow-left-long" />Go back home</Link>
      <Link href="/ux-projects/venus" underline
        >Next case study: Venus<Icon name="arrow-right-long" /></Link
      >
    </div>
  </div>
</Layout>

<style>
  .case-category {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  /* `hidden` on inactive tabpanel uses the HTML attribute only (avoid display toggles vs [hidden]). */

  .tab-button {
    align-items: center;
    color: rgba(var(--foreground), 1);
    cursor: pointer;
    flex: 1;
    padding-block: 1rem;
    padding-inline: 0.75rem;
    position: relative;
    text-align: center;
    transition: color 0.25s;
    z-index: 1;
  }

  .tab-button h3 {
    align-items: center;
    display: flex;
    font-size: 1.0625rem;
    gap: 0.5rem;
    justify-content: center;
  }

  .tab-button[aria-selected="true"] {
    color: rgba(var(--primary-color), 1);
    font-weight: 500;
  }

  .tab-button:active {
    opacity: 0.75;
  }

  .tab-button:focus-visible {
    border-radius: 1.4rem;

    outline: dashed 2px rgba(var(--secondary-color), 1);
