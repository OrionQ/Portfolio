              width={2400}
              quality={100}
              class="rounded-xl w-full h-auto object-contain bg-[rgba(var(--floating-color),0.35)]"
            />
          </figure>
          <figure class="capstone-figure">
            <figcaption
              class="text-sm pb-2 text-[rgba(var(--foreground-color),0.72)] font-medium"
            >
              Orientation step: contextualizes Create, Configure, and Train.
            </figcaption>
            <Image
              format="png"
              src={facultyEvalTutorialStep}
              alt="Tutorial explaining Create Configure and Train sections"
              width={2400}
              quality={100}
              class="rounded-xl w-full h-auto object-contain bg-[rgba(var(--floating-color),0.35)]"
            />
          </figure>
          <figure class="capstone-figure">
            <figcaption
              class="text-sm pb-2 text-[rgba(var(--foreground-color),0.72)] font-medium"
            >
              Chat scaffolding: an alternative to typing every field manually.
            </figcaption>
            <Image
              format="png"
              src={facultyEvalChatStep}
              alt="Tutorial tooltip on tutor creation chat syncing fields"
              width={2400}
              quality={100}
              class="rounded-xl w-full h-auto object-contain bg-[rgba(var(--floating-color),0.35)]"
            />
          </figure>
          <figure class="capstone-figure">
            <figcaption
              class="text-sm pb-2 text-[rgba(var(--foreground-color),0.72)] font-medium"
            >
              Configure cue: anchors the fields that feed calibration logic.
            </figcaption>
            <Image
              format="png"
              src={facultyEvalConfigureStep}
              alt="Tutorial tooltip on learner characteristics in Configure tab"
              width={2400}
              quality={100}
              class="rounded-xl w-full h-auto object-contain bg-[rgba(var(--floating-color),0.35)]"
            />
          </figure>
        </div>
        <figure class="capstone-hero-thumb mt-2">
          <figcaption
            class="text-sm pb-2 text-[rgba(var(--foreground-color),0.72)] font-medium"
          >
            Early evaluation dashboard: how AI surfaces cross-field risks to
            faculty.
          </figcaption>
          <Image
            format="png"
            src={facultyEvalThumbnail}
            alt="Full tutor evaluation concept showing key findings and overview"
            width={2400}
            quality={100}
            class="rounded-xl w-full h-auto object-contain"
          />
        </figure>
      </div>

      <SectionHeading
        index="04"
        title="Faculty research: usability findings"
        id="capstone-interviews"
      />
      <div class="cs-section-body">
        <p class="project-description">
          Four faculty and instructional partners tested two Figma prototypes in
          moderated remote think-aloud sessions (30 to 45 minutes).
        </p>
        <Points>
          <Point title="Tutorial &amp; language">
            <p>The wording was confusing, and people wanted concrete examples.</p>
          </Point>
          <Point title="Cognitive load">
            <p>Empty states jumped straight into exhaustive detail, and faculty felt overwhelmed.</p>
          </Point>
          <Point title="Fitness of the model">
            <p>Faculty wanted to customize the evaluation prompts.</p>
          </Point>
          <Point title="Surfacing severity">
            <p>Color coding helped, but critical issues needed extra cues and accessibility support.</p>
          </Point>
          <Point title="Evidence &amp; authenticity">
            <p>Auto-fix and heavy nudging need visible scope and consent boundaries that protect instructors&apos; ideas.</p>
          </Point>
        </Points>
      </div>

      <SectionHeading
        index="05"
        title="Iteration: reducing information overload"
        id="capstone-iteration"
      />
      <div class="cs-section-body">
        <p class="project-description">
          I staged complexity: risk summary first, prioritized fixes next,
          field-by-field detail last. Each tab isolates one job to avoid the
          &ldquo;everything at once&rdquo; fatigue faculty described.
        </p>
        <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
          <div class="capstone-iteration-figure flex min-w-0 flex-col gap-2">
            <strong>Suggestions & recommendations</strong>
            <Image
              format="png"
              src={facultyEvalRecommendations}
              alt="Tutor Evaluation tab showing key findings overview and suggestion cards"
