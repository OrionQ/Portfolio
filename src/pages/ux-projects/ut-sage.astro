      <div class="tab-indicator" aria-hidden="true" id="tab-indicator"></div>
      <button
        type="button"
        aria-controls="redesignCase"
        aria-selected="true"
        class="tab-button min-w-0"
        data-category="redesignCase"
        id="tab-redesign-case"
        role="tab"
