import sageFoundations from "../../images/Sage_Foundations.png";
import sageHelpCenterPage from "../../images/Sage_Help_center_transition.png";
import sageHomepageProduction from "../../images/Sage_Home_screen_product.png";
import sageHomepageTransition from "../../images/Sage_Home_screen_transition.png";
import sageLofi from "../../images/Sage_Lofi.png";
import sageOriginalDesign1 from "../../images/Sage_Original_issue_1.png";
import sageOriginalDesign2 from "../../images/Sage_Original_issue_2.png";
import sageOriginalIssueList from "../../images/Sage_Original_issue_list.png";
import sageOriginalToggle from "../../images/Sage_Toggle_issue.png";
