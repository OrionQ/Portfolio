              quality={100}
              class="rounded-xl w-full h-auto object-contain bg-[rgba(var(--floating-color),0.35)]"
            />
          </figure>
        </div>
        <figure class="capstone-hero-thumb mt-2">
          <figcaption
            class="text-sm pb-2 text-[rgba(var(--foreground-color),0.72)] font-medium"
          >
            Early evaluation dashboard: how AI surfaces cross-field risks to
            faculty.
          </figcaption>
          <Image
            format="png"
            src={facultyEvalThumbnail}
            alt="Full tutor evaluation concept showing key findings and overview"
            width={2400}
            quality={100}
            class="rounded-xl w-full h-auto object-contain"
          />
        </figure>
      </div>

      <SectionHeading
        index="04"
        title="Faculty research: usability findings"
        id="capstone-interviews"
      />
      <div class="cs-section-body">
        <p class="project-description">
          We ran moderated remote think-aloud sessions (30 to 45 minutes) with
          four UT Austin faculty and instructional partners, who evaluated two
          Figma prototypes: a guided tutorial overlay and the tutor
          evaluation UI.
        </p>
        <div class="cs-card-grid">
          <Card cardType="outline">
            <h3>Tutorial & language</h3>
            <p>The language was confusing and didn&apos;t support learning, and several participants wanted more concrete examples.</p>
          </Card>
          <Card cardType="outline">
            <h3>Cognitive load</h3>
            <p>Empty states jumped straight into exhaustive detail on the evaluation page, and faculty felt overwhelmed by the amount of information.</p>
          </Card>
          <Card cardType="outline">
