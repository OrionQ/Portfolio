---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Card from "../../components/card/Card.astro";
import CaseStudyFooterNav from "../../components/case-study/CaseStudyFooterNav.astro";
import CaseStudyQuestion from "../../components/case-study/CaseStudyQuestion.astro";
import CaseStudyHero from "../../components/case-study/CaseStudyHero.astro";
import Chip from "../../components/chip/Chip.astro";
import MetaItem from "../../components/case-study/MetaItem.astro";
import PageLink from "../../components/page-link/PageLink.astro";
import SectionHeading from "../../components/case-study/SectionHeading.astro";
import Stat from "../../components/case-study/Stat.astro";
import StatRow from "../../components/case-study/StatRow.astro";
import Layout from "../../layouts/Layout.astro";
import "./ux-projects.css";

import venusArt from "../../images/Venus-art.jpeg";
import venusColor from "../../images/Venus-color.png";
import venusDesignSystem from "../../images/Venus-design-system.png";
import venusFeedback from "../../images/Venus-feedback.png";
import venusFont from "../../images/Venus-font.png";
import venusChatHifi from "../../images/Venus-hifi-chat.png";
import venusIcebreakerHifi from "../../images/Venus-hifi-icebreaker.gif";
import venusMatchHifi from "../../images/Venus-hifi-match.png";
import venusMessageHifi from "../../images/Venus-hifi-message.gif";
import venusMilestoneHifi from "../../images/Venus-hifi-milestone.gif";
import venusOnboardHifi from "../../images/Venus-hifi-onboard.png";
import venusProgressHifi from "../../images/Venus-hifi-progress.png";
import venusHomepageFix from "../../images/Venus-homepage-fix.png";
import venusIcebreakerDesignFix from "../../images/Venus-icebreaker-design-fix.gif";
import venusIcebreakerFix from "../../images/Venus-icebreaker-fix.png";
import venusMatchLofi from "../../images/Venus-match-lofi.png";
import venusMatchProfileFix from "../../images/Venus-match-profile-fix.gif";
import venusMatchUnmatchFix from "../../images/Venus-match-unmatch-fix.gif";
import venusOnboardingFix from "../../images/Venus-onboarding-fix.png";
import venusProgressLofi from "../../images/Venus-progress-lofi.png";
import venusStoryMap from "../../images/Venus-story-map.png";
import venusStoryboard from "../../images/Venus-storyboard.png";
import venusTrendsFix from "../../images/Venus-trends-fix.png";
import venusThumbnail from "../../images/Venus_thumbnail.jpeg";
---

<Layout title="Venus - UX Project | Xiaolei Qin's Portfolio">
  <div class="project-container">
    <CaseStudyHero
      title="Venus"
      tagline="Most dating apps turn love into a numbers game. Venus helps you find your best matches and plan your dates."
    />

    <div class="cs-hero-media cs-wide flex md:flex-row gap-4 overflow-x-auto lg:justify-center">
      <Image
        format="jpeg"
        src={venusThumbnail}
        alt="Venus app shown in a phone mockup"
        width={1080}
        quality={100}
        class="rounded-[var(--border-radius)] object-cover"
      />
    </div>

    <div class="cs-meta cs-wide">
      <MetaItem label="Project type">
        <p class="cs-inline-result">Team project, UX prototyping</p>
      </MetaItem>
      <MetaItem label="My role">
        <p class="cs-inline-result">Product Designer</p>
      </MetaItem>
      <MetaItem label="Tools">
        <Chip title="Figma" level="professional" showLevel={false}>
          <Icon slot="icon" name="figma-brands-solid-full" size={18} aria-hidden />
        </Chip>
        <Chip title="Framer" level="proficient" showLevel={false}>
          <Icon slot="icon" name="framer" size={18} aria-hidden />
        </Chip>
        <Chip title="FigJam" level="professional" showLevel={false}>
          <Icon slot="icon" name="figma-brands-solid-full" size={18} aria-hidden />
        </Chip>
      </MetaItem>
    </div>

    <StatRow>
      <Stat value="18+" label="components in the design system" />
      <Stat value="7" label="tasks in face-to-face moderated usability tests" />
      <Stat value="22–34" label="age range of test participants" />
    </StatRow>

    <CaseStudyQuestion
      long
      question="Endless swiping keeps people chasing better matches while they grow less invested in the ones they already have, and we set out to change that."
    />

    <div
      class="flex flex-row gap-4 flex-wrap md:flex-nowrap justify-center items-center"
    >
      <Image
        format="jpeg"
        src={venusArt}
        alt="Still Life with Silver and Gold Vessels, Fruit, and Flowers at Blanton Museum"
        width={600}
        quality={100}
        class="rounded-[var(--border-radius)] object-cover flex basis-1/2 w-full h-full"
      />
      <p class="project-description">
        The idea started at the Blanton Museum of Art, in front of Pierre Nicolas
        Huilliot&apos;s <em
        >Still Life with Silver and Gold Vessels, Fruit, and
        Flowers</em
        >. Venus, the goddess of love, watches over the scene with Cupid beside
        her, so we imagined the app as Venus guiding users to love, with Cupid
        suggesting matches and dates.
      </p>
    </div>

    <SectionHeading
      index="01"
      title="Storyboards & story mapping"
      id="storyboards-and-story-mapping"
    />
    <div class="cs-section-body">
      <p class="project-description">
        I sketched a storyboard first: Cupid, an AI assistant, acts as a
        matchmaker, users get hand-picked matches, and they can plan dates in the
        app. We then interviewed people about what they like and dislike in
        current dating apps, built an affinity diagram, and mapped the tasks we
        wanted to support.
      </p>
      <div class="flex flex-row gap-4 md:flex-nowrap flex-wrap justify-center">
        <Image
          format="jpeg"
          src={venusStoryboard}
          alt="Venus storyboard"
          width={1509}
          quality={100}
          class="rounded-[var(--border-radius)] object-cover"
        />
      </div>
      <Image
        format="jpeg"
        src={venusStoryMap}
        alt="Venus story map"
        width={1724}
        quality={100}
        class="rounded-[var(--border-radius)] object-cover"
      />
      <PageLink
        aria-label="Story map (opens a new window)"
        href="https://www.figma.com/board/mY9oUJMC48AIhXsCqZJhRi/UXerrrs---Venus?node-id=97-240&t=nX3I4yIU5zZSiI9B-1"
        newTab>Story map</PageLink
      >
    </div>

    <SectionHeading
      index="02"
      title="Low-fi & mid-fi prototype"
      id="low-fi-and-mid-fi-prototype"
    />
    <div class="cs-section-body">
      <p class="project-description">
        I created the match flow: how users see Cupid&apos;s picks and what
        they can do with each match. The team covered onboarding, edit
        profile, progress, and the icebreaker game.
      </p>
      <ul class="flex flex-col gap-8 items-center">
        <li class="flex flex-col gap-4 items-center">
          <strong>Match screen</strong>
          <Image
            format="jpeg"
            src={venusMatchLofi}
            alt="Low-fi prototype of the match screen"
            width={1870}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover"
          />
          <p>
            No swiping: users open a recommended profile and choose to talk. I also
            added an unmatch flow where they can pick a common reason or describe
            their own.
          </p>
        </li>
        <li class="flex flex-col gap-4 items-center">
          <strong>Progress screen</strong>
          <Image
            format="jpeg"
            src={venusProgressLofi}
            alt="Low-fi prototype of the progress screen"
            width={1378}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover"
          />
          <p>How users are doing with current matches, and trends in who they like.</p>
        </li>
      </ul>
      <PageLink
        aria-label="Lo-fi and mid-fi screens (opens a new window)"
        href="https://www.figma.com/design/vJ7tcgxj5pqgSlNJf5xfUD/Venus-UXerrrs-Prototype?node-id=0-1&t=RUaaQ9s8gLW5PpKw-1"
        newTab>All lo-fi and mid-fi screens</PageLink
      >
    </div>

    <SectionHeading
      index="03"
      title="Making a design system"
      id="making-a-design-system"
    />
    <div class="cs-section-body">
      <p class="project-description">
        I skipped aggressive reds and pinks so the app wouldn&apos;t feel like
        &ldquo;love at first swipe.&rdquo; <strong>Ice blue</strong> is our primary
        color and <strong>Storm</strong> is our action color, both calm and
        trustworthy, and different from other dating apps. Since the app is named
        after Venus, a classic Greek figure, the logo font is
        <strong>Playwrite US Trad</strong> for a classic feel, with
        <strong>Poppins</strong> for readable body text on small screens.
      </p>
      <Image
        format="jpeg"
        src={venusColor}
        alt="Venus design system color palette"
        width={1526}
        quality={100}
        class="rounded-[var(--border-radius)] block mx-auto max-w-full h-auto object-cover"
      />
      <Image
        format="jpeg"
        src={venusFont}
        alt="Venus design system font"
        width={1114}
        quality={100}
        class="rounded-[var(--border-radius)] block mx-auto max-w-full h-auto object-cover"
      />
      <div class="cs-inline-detail">
        <p class="cs-subhead">Components &amp; the design system</p>
        <p class="project-description">
          A good design system keeps design consistent and efficient, and building
          it is one of my favorite parts of the process. I built 18+ components with
          consistent radius and spacing, and a teammate added color variables for
          states like hover and active, which kept the hi-fi prototype consistent.
        </p>
        <Image
          format="jpeg"
          src={venusDesignSystem}
          alt="Venus design system components"
          width={1712}
          quality={100}
          class="rounded-[var(--border-radius)] block mx-auto max-w-full h-auto object-cover"
        />
      </div>
      <PageLink
        aria-label="Full design system (opens a new window)"
        href="https://www.figma.com/design/vJ7tcgxj5pqgSlNJf5xfUD/Venus-UXerrrs-Prototype?node-id=534-10197&t=RUaaQ9s8gLW5PpKw-1"
        newTab>Full design system</PageLink
      >
    </div>

    <SectionHeading
      index="04"
      title="First hi-fi iteration"
      id="first-iteration-of-hi-fi-prototype"
    />
    <div class="cs-section-body">
      <p class="project-description">
        We brought the design system into a hi-fi prototype with
        microanimations and interactions.
      </p>
      <ul class="flex flex-col gap-8 items-center">
        <li class="flex flex-col gap-4 items-center">
          <strong>Onboarding</strong>
          <Image
            format="png"
            src={venusOnboardHifi}
            alt="Hi-fi prototype of the onboarding screen"
            width={1025}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover"
          />
          <p>Profile setup and app mechanics. Testing later showed issues here.</p>
        </li>
        <li class="flex flex-col gap-4 items-center">
          <strong>Match screen</strong>
          <Image
            format="png"
            src={venusMatchHifi}
            alt="Hi-fi prototype of the match screen"
            width={1025}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover"
          />
          <p>The match and unmatch flow, with reasons users can pick from.</p>
        </li>
        <li class="flex flex-col gap-4 items-center">
          <strong>Chat & icebreaker</strong>
          <Image
            format="png"
            src={venusChatHifi}
            alt="Hi-fi prototype of the chat screen"
            width={1025}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover"
          />
          <p>The chat screen, plus an icebreaker game so users can learn about a match before messaging.</p>
        </li>
        <li class="flex flex-col gap-4 items-center">
          <strong>Home / progress</strong>
          <Image
            format="png"
            src={venusProgressHifi}
            alt="Hi-fi prototype of the home/progress screen"
            width={1024}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover"
          />
          <p>Current matches and how they&apos;re doing in the app.</p>
        </li>
      </ul>
      <p>Some microanimations we added:</p>
      <div
        class="flex flex-col lg:flex-row gap-8 justify-center items-center"
      >
        <Image
          src={venusMessageHifi}
          alt="Hi-fi prototype of the message screen with animation"
          width={250}
          quality={100}
          class="rounded-[2.7rem] object-cover"
        />
        <Image
          src={venusIcebreakerHifi}
          alt="Hi-fi prototype of the icebreaker screen with animation"
          width={250}
          quality={100}
          class="rounded-[2.7rem] object-cover"
        />
        <Image
          src={venusMilestoneHifi}
          alt="Hi-fi prototype of the milestone screen with animation"
          width={250}
          quality={100}
          class="rounded-[2.7rem] object-cover"
        />
      </div>
    </div>

    <SectionHeading
      index="05"
      title="Usability testing & feedback"
      id="usability-testing-and-feedback"
    />
    <div class="cs-section-body">
      <p class="project-description">
        We didn&apos;t want the app built in a small dark room by a group of
        designers, so we put it in front of real users. We ran moderated,
        face-to-face tests with <strong>7 tasks</strong>, and each of us tested
        <strong>2 participants</strong> (ages 22 to 34, mixed gender and
        sexuality). Notes and post-task forms went into a feedback board, which we
        synthesized into what worked and what didn&apos;t.
      </p>
      <Image
        format="jpeg"
        src={venusFeedback}
        alt="Usability testing feedback and affinity diagram"
        width={2400}
        quality={100}
        class="rounded-[var(--border-radius)] object-cover"
      />
      <p class="cs-subhead">Key findings we acted on</p>
      <div class="cs-card-grid">
        <Card cardType="outline">
          <h3>Most liked ✅ Icebreaker</h3>
          <p>
            It eased first-contact tension: <em
              >&ldquo;This is a fun way to interact from the
              beginning.&rdquo;</em
            > and <em
              >&ldquo;Makes me feel more comfortable and will help spark
              conversation.&rdquo;</em
            >
          </p>
        </Card>
        <Card cardType="outline">
          <h3>Least liked 🙅 Milestones</h3>
          <p>
            Milestones caused the most trouble, so we knew we had to rethink
            them: <em>&ldquo;Don&apos;t really understand the point.&rdquo;</em>
            and <em
              >&ldquo;Don&apos;t see the point if the app is meant to make
              meaningful connections.&rdquo;</em
            >
          </p>
        </Card>
        <Card cardType="outline" className="md:col-span-2">
          <h3>Main confusion 😵‍💫 Onboarding & unmatching</h3>
          <p>
            Many users found the onboarding tutorials overwhelming and had
            trouble unmatching: <em
              >&ldquo;Tutorial was confusing and hard to follow, there was too
              much text/info right off the bat.&rdquo;</em
            > and <em
              >&ldquo;Difficult to unmatch — would expect the unmatch button to
              be in the chat.&rdquo;</em
            >
          </p>
        </Card>
      </div>
      <PageLink
        aria-label="Usability testing issues (opens a new window)"
        href="https://docs.google.com/document/d/19XGEG-5LmSHIG5xlZV4YZSuPcBzWw46jsgjno9D9myM/edit?usp=sharing"
        newTab>Full logged issues</PageLink
      >
    </div>

    <SectionHeading
      index="06"
      title="Iteration & final prototype"
      id="iteration-and-final-prototype"
    />
    <div class="cs-section-body">
      <p class="project-description">
        After classifying the issues, I focused on the major ones from our
        feedback summary. With limited time, I prioritized the issues that
        most affected the user experience.
      </p>

      <Card cardType="outline" className="flex flex-col gap-2">
        <h3>6.1 Onboarding</h3>
        <p>
          <strong>Issue:</strong> too many tooltips and instruction pages at once,
          so people couldn&apos;t take it in or use it later.
          <strong>Fix:</strong> contextual pop-ups shown the first time a user
          reaches each screen, with a dimmed background and one focused message.
        </p>
      </Card>
      <Image
        format="jpeg"
        src={venusOnboardingFix}
        alt="Fix on the onboarding screen"
        width={2400}
        quality={100}
        class="rounded-[var(--border-radius)] object-cover"
      />
      <Card cardType="outline" className="flex flex-col gap-2">
        <h3>6.2 Milestones &amp; Cupid&apos;s recommendations</h3>
        <p>
          <strong>Issue:</strong> people couldn&apos;t tell milestones from match
          trends, and the progress bar conveyed little. <strong>Fix:</strong> I
          reordered the milestones, dropped the progress bar, and added
          &ldquo;Cupid&apos;s dating ideas,&rdquo; which suggest dates (locations,
          availability) based on ongoing conversations.
        </p>
      </Card>
      <Image
        format="jpeg"
        src={venusHomepageFix}
        alt="Fix on the homepage screen"
        width={2400}
        quality={100}
        class="rounded-[var(--border-radius)] object-cover"
      />
      <Card cardType="outline" className="flex flex-col gap-2">
        <h3>6.3 Match trends</h3>
        <p>
          <strong>Issue:</strong> trends didn&apos;t feel tied to actual matches, and
          the layout felt flat. <strong>Fix:</strong> I combined Cupid&apos;s notes
          with trends and added match profiles beside &ldquo;my match pattern,&rdquo;
          so users can see who fits those trends.
        </p>
      </Card>
      <Image
        format="jpeg"
        src={venusTrendsFix}
        alt="Fix on the trends screen"
        width={2176}
        quality={100}
        class="rounded-[var(--border-radius)] object-cover"
      />
      <Card cardType="outline" className="flex flex-col gap-2">
        <h3>6.4 Match profile</h3>
        <p>
          <strong>Issue:</strong> in chat, tapping a match gave no feedback, and
          users couldn&apos;t unmatch once a conversation started.
          <strong>Fix:</strong> tapping a match&apos;s picture now opens their full
          profile, where users can also unmatch.
        </p>
      </Card>
      <div class="flex flex-col md:flex-row gap-8 justify-center items-center">
        <Image
          src={venusMatchProfileFix}
          alt="Fix on the match profile screen"
          width={250}
          quality={100}
          class="rounded-[2.7rem] object-cover"
        />
        <Image
          src={venusMatchUnmatchFix}
          alt="Fix on being able to unmatch from the match profile screen"
          width={250}
          quality={100}
          class="rounded-[2.7rem] object-cover"
        />
      </div>
      <Card cardType="outline" className="flex flex-col gap-2">
        <h3>6.5 Icebreaker</h3>
        <p>
          <strong>Issue:</strong> match images had no names, so people couldn&apos;t
          tell who was who, and it was unclear whether results went to the match or
          needed a message afterward. <strong>Fix:</strong> profile cards follow the
          &ldquo;Today&apos;s match&rdquo; style with names below the photo, and the
          questionnaire is visually distinct from chat.
        </p>
      </Card>
      <Image
        format="jpeg"
        src={venusIcebreakerFix}
        alt="Fix on the icebreaker screen"
        width={2400}
        quality={100}
        class="rounded-[var(--border-radius)] object-cover"
      />
      <p>Transition between icebreaker screens:</p>
      <div class="flex flex-col md:flex-row gap-8 justify-center items-center">
        <Image
          src={venusIcebreakerDesignFix}
          alt="Icebreaker screen transition"
          width={250}
          quality={100}
          class="rounded-[2.7rem] object-cover"
        />
      </div>

      <p class="project-description">
        After this round, I finalized the hi-fi prototype by adding conditional
        logic and microanimations. Give it a spin through the link or the embedded
        version below.
      </p>
      <PageLink
        aria-label="Final prototype (opens a new window)"
        href="https://www.figma.com/proto/vJ7tcgxj5pqgSlNJf5xfUD/Venus-UXerrrs-Prototype?node-id=2123-10671&t=va4XPmG3kQXYNyG1-0&scaling=scale-down&content-scaling=fixed&starting-point-node-id=2123%3A10671"
        newTab>Final prototype</PageLink
      >
      <iframe
        aria-label="Venus final prototype"
        class="rounded-[var(--border-radius)] w-full"
        style="border: 3px solid rgba(var(--floating-color), 1); box-shadow: 0 1px 4px rgba(0,0,0,0.15);"
        width="800"
        height="450"
        src="https://embed.figma.com/proto/vJ7tcgxj5pqgSlNJf5xfUD/Venus-UXerrrs-Prototype?node-id=2123-10671&scaling=scale-down&content-scaling=fixed&page-id=2081%3A5656&starting-point-node-id=2123%3A10671&show-proto-sidebar=1&embed-host=share"
        allowfullscreen
      >
      </iframe>
    </div>

    <SectionHeading
      index="07"
      title="Future plans & my learnings"
      id="future-plans-and-my-learnings"
    />
    <div class="cs-section-body">
      <p class="cs-subhead">Future plans</p>
      <ul class="flex flex-col gap-2 project-description">
        <li>Run more comprehensive usability tests with a wider range of participants.</li>
        <li>Integrate Cupid more deeply, with shortcuts for making reservations and blocking out your calendar.</li>
        <li>Have Cupid suggest safety tips and help users recognize unhealthy conversations or warning signs.</li>
        <li>Continue iterating on the design and content.</li>
      </ul>
      <p class="cs-subhead">What I learned</p>
      <div class="cs-card-grid">
        <Card cardType="outline">
          <h3>Collaborating with teammates is challenging but rewarding</h3>
          <p>Different backgrounds and experience levels meant we had to work at understanding each other. Clear ownership, good communication, and leaning on each other&apos;s strengths made it work.</p>
        </Card>
        <Card cardType="outline">
          <h3>Be open-minded with opinions</h3>
          <p>I originally pushed for dark green as our primary color, but the team
preferred ice blue, and users liked it. Letting go of that preference was
the right call.</p>
        </Card>
        <Card cardType="outline" className="md:col-span-2">
          <h3>Prioritize when time is limited</h3>
          <p>We couldn&apos;t build everything we imagined. Focusing on the most important features and iterating from feedback helped us ship something usable and learn from it.</p>
        </Card>
      </div>
    </div>

    <CaseStudyFooterNav
      prev={{ href: "/ux-projects/ut-sage", label: "Previous case study: UT Sage" }}
      next={{ href: "/ux-projects/reddit", label: "Next case study: Reddit Usability Test" }}
      divider={false}
    />
  </div>
</Layout>
