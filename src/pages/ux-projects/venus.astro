---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Card from "../../components/card/Card.astro";
import CaseStudyHero from "../../components/case-study/CaseStudyHero.astro";
import Chip from "../../components/chip/Chip.astro";
import Disclosure from "../../components/disclosure/Disclosure.astro";
import MetaItem from "../../components/case-study/MetaItem.astro";
import PageLink from "../../components/page-link/PageLink.astro";
import SectionHeading from "../../components/case-study/SectionHeading.astro";
import Stat from "../../components/case-study/Stat.astro";
import StatRow from "../../components/case-study/StatRow.astro";
import Link from "../../components/link/Link.astro";
import Layout from "../../layouts/Layout.astro";
import "./ux-projects.css";

import venusArt from "../../images/Venus-art.jpeg";
import venusColor from "../../images/Venus-color.png";
import venusDesignSystem from "../../images/Venus-design-system.png";
import venusFeedback from "../../images/Venus-feedback.png";
import venusFont from "../../images/Venus-font.png";
import venusChatHifi from "../../images/Venus-hifi-chat.png";
import venusIcebreakerHifi from "../../images/Venus-hifi-icebreaker.gif";
import venusMatchHifi from "../../images/Venus-hifi-match.png";
import venusMessageHifi from "../../images/Venus-hifi-message.gif";
import venusMilestoneHifi from "../../images/Venus-hifi-milestone.gif";
import venusOnboardHifi from "../../images/Venus-hifi-onboard.png";
import venusProgressHifi from "../../images/Venus-hifi-progress.png";
import venusHomepageFix from "../../images/Venus-homepage-fix.png";
import venusIcebreakerDesignFix from "../../images/Venus-icebreaker-design-fix.gif";
import venusIcebreakerFix from "../../images/Venus-icebreaker-fix.png";
import venusMatchLofi from "../../images/Venus-match-lofi.png";
import venusMatchProfileFix from "../../images/Venus-match-profile-fix.gif";
import venusMatchUnmatchFix from "../../images/Venus-match-unmatch-fix.gif";
import venusOnboardingFix from "../../images/Venus-onboarding-fix.png";
import venusProgressLofi from "../../images/Venus-progress-lofi.png";
import venusStoryMap from "../../images/Venus-story-map.png";
import venusStoryboard from "../../images/Venus-storyboard.png";
import venusTrendsFix from "../../images/Venus-trends-fix.png";
import venusThumbnail from "../../images/Venus_thumbnail.jpeg";
---

<Layout title="Venus - UX Project | Xiaolei Qin's Portfolio">
  <div class="project-container">
    <CaseStudyHero
      kicker="Team project — UX prototyping"
      title="Venus"
      tagline="Most dating apps turn love into a numbers game. Venus helps you find matches worth investing in — and plan the date after."
    >
      <Fragment slot="meta">
        <MetaItem label="Role">
          <p class="cs-inline-result">
            Design system, interactions, usability fixes
          </p>
        </MetaItem>
        <MetaItem label="Tools">
          <Chip title="Figma" level="professional" showLevel={false}>
            <Icon slot="icon" name="figma-brands-solid-full" size={18} aria-hidden />
          </Chip>
          <Chip title="Framer" level="proficient" showLevel={false}>
            <Icon slot="icon" name="framer" size={18} aria-hidden />
          </Chip>
          <Chip title="FigJam" level="professional" showLevel={false}>
            <Icon slot="icon" name="figma-brands-solid-full" size={18} aria-hidden />
          </Chip>
        </MetaItem>
      </Fragment>
    </CaseStudyHero>

    <div class="cs-hero-image">
      <Image
        format="jpeg"
        src={venusThumbnail}
        alt="Venus app shown in a phone mockup"
        width={1600}
      />
    </div>

    <StatRow>
      <Stat value="18+" label="components in the design system" />
      <Stat value="7" label="tasks tested with 14 total participants" />
      <Stat value="22–34" label="age range of test participants" />
    </StatRow>

    <div class="cs-section-columns cs-columns-image-first">
      <div class="cs-section-image">
        <Image
          format="jpeg"
          src={venusArt}
          alt="Still Life with Silver and Gold Vessels, Fruit, and Flowers at Blanton Museum"
          width={800}
        />
      </div>
      <div class="cs-section-body">
        <p class="cs-subhead">Inspired by the art, built by the team</p>
        <p class="project-description">
          The idea started at a museum, in front of Pierre Nicolas
          Huilliot&apos;s <em
            >Still Life with Silver and Gold Vessels, Fruit, and
            Flowers</em
          >. Venus watches over the scene; Cupid stands beside her. So the
          app became Venus — with an AI matchmaker, Cupid, doing the
          suggesting.
        </p>
      </div>
    </div>

    <SectionHeading
      index="01"
      title="Storyboards & story mapping"
      id="storyboards-and-story-mapping"
    />
    <div class="cs-section-body">
      <p class="project-description">
        I sketched the storyboard first: Cupid hand-picks matches, users
        plan dates in-app. We interviewed people about what they liked and
        hated in dating apps today, then mapped it into a story map of what
        the product needed to do.
      </p>
      <div class="cs-gallery">
        <Image
          format="jpeg"
          src={venusStoryboard}
          alt="Venus storyboard"
          width={500}
        />
        <Image
          format="jpeg"
          src={venusStoryMap}
          alt="Venus story map"
          width={700}
        />
      </div>
      <PageLink
        aria-label="Story map (opens a new window)"
        href="https://www.figma.com/board/mY9oUJMC48AIhXsCqZJhRi/UXerrrs---Venus?node-id=97-240&t=nX3I4yIU5zZSiI9B-1"
        newTab>Story map</PageLink
      >
    </div>

    <SectionHeading
      index="02"
      title="Low-fi & mid-fi prototype"
      id="low-fi-and-mid-fi-prototype"
    />
    <div class="cs-section-body">
      <p class="project-description">
        I built the match flow: how users see Cupid&apos;s picks, and what
        they can do with each one.
      </p>
      <div class="cs-card-grid">
        <Card cardType="secondary">
          <h3>Match screen</h3>
          <Image
            format="jpeg"
            src={venusMatchLofi}
            alt="Low-fi prototype of the match screen"
            width={500}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover w-full my-2"
          />
          <p>
            No swiping. Open a profile, choose to talk. Unmatching lets you
            pick a reason, or write your own.
          </p>
        </Card>
        <Card cardType="secondary">
          <h3>Progress screen</h3>
          <Image
            format="jpeg"
            src={venusProgressLofi}
            alt="Low-fi prototype of the progress screen"
            width={500}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover w-full my-2"
          />
          <p>Current matches, and trends in who you like.</p>
        </Card>
      </div>
      <PageLink
        aria-label="Lo-fi and mid-fi screens (opens a new window)"
        href="https://www.figma.com/design/vJ7tcgxj5pqgSlNJf5xfUD/Venus-UXerrrs-Prototype?node-id=0-1&t=RUaaQ9s8gLW5PpKw-1"
        newTab>All lo-fi and mid-fi screens</PageLink
      >
    </div>

    <SectionHeading
      index="03"
      title="Making a design system"
      id="making-a-design-system"
    />
    <div class="cs-section-body">
      <p class="project-description">
        No reds or pinks — we skipped &ldquo;love at first swipe.&rdquo;
        <strong>Ice blue</strong> and <strong>Storm</strong> carry the
        palette instead: calm, trustworthy, different from every other
        dating app. <strong>Playwright US Trad</strong> nods to Venus&apos;
        mythological roots; <strong>Poppins</strong> keeps body text
        readable on small screens.
      </p>
      <div class="cs-gallery">
        <Image
          format="jpeg"
          src={venusColor}
          alt="Venus design system color palette"
          width={500}
          quality={100}
        />
        <Image
          format="jpeg"
          src={venusFont}
          alt="Venus design system font"
          width={500}
          quality={100}
        />
      </div>
      <Disclosure title="Components & the design system" className="cs-detail">
        <p class="project-description">
          18+ components, consistent radius and spacing. A teammate added
          color variables for hover and active states, so we could move
          fast without breaking consistency.
        </p>
        <Image
          format="jpeg"
          src={venusDesignSystem}
          alt="Venus design system components"
          width={900}
          quality={100}
          class="rounded-[var(--border-radius)] object-cover w-full mt-4"
        />
      </Disclosure>
      <PageLink
        aria-label="Full design system (opens a new window)"
        href="https://www.figma.com/design/vJ7tcgxj5pqgSlNJf5xfUD/Venus-UXerrrs-Prototype?node-id=534-10197&t=RUaaQ9s8gLW5PpKw-1"
        newTab>Full design system</PageLink
      >
    </div>

    <SectionHeading
      index="04"
      title="First hi-fi iteration"
      id="first-iteration-of-hi-fi-prototype"
    />
    <div class="cs-section-body">
      <p class="project-description">
        We brought the design system into a hi-fi prototype with
        micro-animations and real interactions.
      </p>
      <div class="cs-card-grid">
        <Card cardType="secondary">
          <h3>Onboarding</h3>
          <Image
            format="jpeg"
            src={venusOnboardHifi}
            alt="Hi-fi prototype of the onboarding screen"
            width={500}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover w-full my-2"
          />
          <p>Profile setup and app mechanics. Testing later flagged this for rework.</p>
        </Card>
        <Card cardType="secondary">
          <h3>Match screen</h3>
          <Image
            format="jpeg"
            src={venusMatchHifi}
            alt="Hi-fi prototype of the match screen"
            width={500}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover w-full my-2"
          />
          <p>Match and unmatch, with reasons to pick from.</p>
        </Card>
        <Card cardType="secondary">
          <h3>Chat & icebreaker</h3>
          <Image
            format="jpeg"
            src={venusChatHifi}
            alt="Hi-fi prototype of the chat screen"
            width={500}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover w-full my-2"
          />
          <p>A game to learn about a match before you message them.</p>
        </Card>
        <Card cardType="secondary">
          <h3>Home / progress</h3>
          <Image
            format="jpeg"
            src={venusProgressHifi}
            alt="Hi-fi prototype of the home/progress screen"
            width={500}
            quality={100}
            class="rounded-[var(--border-radius)] object-cover w-full my-2"
          />
          <p>Current matches, and how they&apos;re going.</p>
        </Card>
      </div>
      <Disclosure title="Microanimations" className="cs-detail">
        <div class="flex flex-col md:flex-row gap-6 justify-center items-center pt-2">
          <Image
            src={venusMessageHifi}
            alt="Hi-fi prototype of the message screen with animation"
            width={220}
            quality={100}
            class="rounded-[2.7rem] object-cover"
          />
          <Image
            src={venusIcebreakerHifi}
            alt="Hi-fi prototype of the icebreaker screen with animation"
            width={220}
            quality={100}
            class="rounded-[2.7rem] object-cover"
          />
          <Image
            src={venusMilestoneHifi}
            alt="Hi-fi prototype of the milestone screen with animation"
            width={220}
            quality={100}
            class="rounded-[2.7rem] object-cover"
          />
        </div>
      </Disclosure>
    </div>

    <SectionHeading
      index="05"
      title="Usability testing & feedback"
      id="usability-testing-and-feedback"
    />
    <div class="cs-section-body">
      <p class="project-description">
        We tested face-to-face: <strong>7 tasks</strong>, each of us with
        <strong>2 participants</strong> (ages 22–34). Notes and post-task
        forms went into a shared feedback board.
      </p>
      <div class="cs-hero-image">
        <Image
          format="jpeg"
          src={venusFeedback}
          alt="Usability testing feedback and affinity diagram"
          width={1400}
          quality={100}
        />
      </div>
      <p class="cs-subhead">Key findings we acted on</p>
      <div class="cs-card-grid">
        <Card cardType="secondary">
          <h3>Most liked ✅ Icebreaker</h3>
          <p>
            Eased first-contact tension: <em
              >&ldquo;This is a fun way to interact from the
              beginning.&rdquo;</em
            >
          </p>
        </Card>
        <Card cardType="secondary">
          <h3>Least liked 🙅 Milestones</h3>
          <p>
            <em
              >&ldquo;Don&apos;t see the point if the app is meant to make
              meaningful connections.&rdquo;</em
            >
          </p>
        </Card>
        <Card cardType="secondary" className="md:col-span-2">
          <h3>Main confusion 😵‍💫 Onboarding & unmatching</h3>
          <p>
            <em
              >&ldquo;Tutorial was confusing — too much text right off the
              bat.&rdquo;</em
            > and <em
              >&ldquo;Difficult to unmatch — would expect that button in the
              chat.&rdquo;</em
            >
          </p>
        </Card>
      </div>
      <PageLink
        aria-label="Usability testing issues (opens a new window)"
        href="https://docs.google.com/document/d/19XGEG-5LmSHIG5xlZV4YZSuPcBzWw46jsgjno9D9myM/edit?usp=sharing"
        newTab>Full logged issues</PageLink
      >
    </div>

    <SectionHeading
      index="06"
      title="Iteration & final prototype"
      id="iteration-and-final-prototype"
    />
    <div class="cs-section-body">
      <p class="project-description">
        With limited time left, I prioritized the fixes most impactful to
        the experience.
      </p>

      <Disclosure title="6.1 Onboarding" className="cs-detail">
        <p class="project-description">
          <strong>Issue:</strong> too many tooltips at once — nobody
          remembered any of it.
          <strong>Fix:</strong> one pop-up per screen, shown only the first
          time you land there.
        </p>
        <Image
          format="jpeg"
          src={venusOnboardingFix}
          alt="Fix on the onboarding screen"
          width={900}
          quality={100}
          class="rounded-[var(--border-radius)] object-cover w-full mt-4"
        />
      </Disclosure>

      <Disclosure title="6.2 Milestones & Cupid's recommendations" className="cs-detail">
        <p class="project-description">
          <strong>Issue:</strong> milestones and match trends looked the
          same, and the progress bar said nothing useful.
          <strong>Fix:</strong> dropped the progress bar, reordered
          milestones, added &ldquo;Cupid&apos;s dating ideas&rdquo; — date
          suggestions pulled straight from your chats.
        </p>
        <Image
          format="jpeg"
          src={venusHomepageFix}
          alt="Fix on the homepage screen"
          width={900}
          quality={100}
          class="rounded-[var(--border-radius)] object-cover w-full mt-4"
        />
      </Disclosure>

      <Disclosure title="6.3 Match trends" className="cs-detail">
        <p class="project-description">
          <strong>Issue:</strong> trends felt disconnected from real
          matches. <strong>Fix:</strong> combined Cupid&apos;s notes with
          trends, and showed match profiles next to &ldquo;my match
          pattern.&rdquo;
        </p>
        <Image
          format="jpeg"
          src={venusTrendsFix}
          alt="Fix on the trends screen"
          width={900}
          quality={100}
          class="rounded-[var(--border-radius)] object-cover w-full mt-4"
        />
      </Disclosure>

      <Disclosure title="6.4 Match profile" className="cs-detail">
        <p class="project-description">
          <strong>Issue:</strong> tapping a match in chat did nothing, and
          you couldn&apos;t unmatch mid-conversation. <strong>Fix:</strong>
          tap the photo to open their profile. Unmatch from there.
        </p>
        <div class="flex flex-col md:flex-row gap-6 justify-center items-center pt-4">
          <Image
            src={venusMatchProfileFix}
            alt="Fix on the match profile screen"
            width={220}
            quality={100}
            class="rounded-[2.7rem] object-cover"
          />
          <Image
            src={venusMatchUnmatchFix}
            alt="Fix on being able to unmatch from the match profile screen"
            width={220}
            quality={100}
            class="rounded-[2.7rem] object-cover"
          />
        </div>
      </Disclosure>

      <Disclosure title="6.5 Icebreaker" className="cs-detail">
        <p class="project-description">
          <strong>Issue:</strong> no names on match photos, and unclear if
          results reached your match. <strong>Fix:</strong> names below
          every photo, and the questionnaire now looks nothing like chat.
        </p>
        <Image
          format="jpeg"
          src={venusIcebreakerFix}
          alt="Fix on the icebreaker screen"
          width={900}
          quality={100}
          class="rounded-[var(--border-radius)] object-cover w-full mt-4"
        />
        <div class="flex justify-center pt-4">
          <Image
            src={venusIcebreakerDesignFix}
            alt="Icebreaker screen transition"
            width={220}
            quality={100}
            class="rounded-[2.7rem] object-cover"
          />
        </div>
      </Disclosure>

      <p class="project-description">
        With conditional logic and micro-animations added throughout, here
        is the finished prototype — give it a spin.
      </p>
      <PageLink
        aria-label="Final prototype (opens a new window)"
        href="https://www.figma.com/proto/vJ7tcgxj5pqgSlNJf5xfUD/Venus-UXerrrs-Prototype?node-id=2123-10671&t=va4XPmG3kQXYNyG1-0&scaling=scale-down&content-scaling=fixed&starting-point-node-id=2123%3A10671"
        newTab>Final prototype</PageLink
      >
      <iframe
        aria-label="Venus final prototype"
        class="rounded-[var(--border-radius)] w-full"
        style="border: 3px solid rgba(var(--floating-color), 1); box-shadow: 0 1px 4px rgba(0,0,0,0.15);"
        width="800"
        height="450"
        src="https://embed.figma.com/proto/vJ7tcgxj5pqgSlNJf5xfUD/Venus-UXerrrs-Prototype?node-id=2123-10671&scaling=scale-down&content-scaling=fixed&page-id=2081%3A5656&starting-point-node-id=2123%3A10671&show-proto-sidebar=1&embed-host=share"
        allowfullscreen
      >
      </iframe>
    </div>

    <SectionHeading
      index="07"
      title="Future plans & my learnings"
      id="future-plans-and-my-learnings"
    />
    <div class="cs-section-body">
      <p class="cs-subhead">Future plans</p>
      <ul class="flex flex-col gap-2 project-description">
        <li>Wider, more comprehensive rounds of usability testing.</li>
        <li>Integrate Cupid further — shortcuts to reservations and calendar blocking.</li>
        <li>Have Cupid surface safety tips and flag unhealthy conversation patterns.</li>
        <li>Keep iterating on design and content.</li>
      </ul>
      <p class="cs-subhead">What I learned</p>
      <div class="cs-card-grid">
        <Card cardType="secondary">
          <h3>Collaboration is hard but worth it</h3>
          <p>Different backgrounds, different habits. Clear ownership and good communication made it work.</p>
        </Card>
        <Card cardType="secondary">
          <h3>Stay open-minded</h3>
          <p>I wanted dark green; the team picked ice blue. Users liked ice blue. Letting go was the right call.</p>
        </Card>
        <Card cardType="secondary" className="md:col-span-2">
          <h3>Prioritize when time is limited</h3>
          <p>We couldn&apos;t build everything we imagined. Focusing on what mattered most shipped something usable.</p>
        </Card>
      </div>
    </div>

    <div class="cs-footer-nav">
      <Link href="/ux-projects/ut-sage" underline
        ><Icon name="arrow-left-long" />Previous case study: UT Sage</Link
      >
      <Link href="/ux-projects/reddit" underline
        >Next case study: Reddit Usability Test<Icon
          name="arrow-right-long"
        /></Link
      >
    </div>
  </div>
</Layout>
